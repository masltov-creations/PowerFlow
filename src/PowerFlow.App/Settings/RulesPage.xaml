<Page
    x:Class="PowerFlow.App.Settings.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="RULES" FontSize="10" CharacterSpacing="220" Opacity="0.45"/>
            <TextBlock Text="Apps that hold the line" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Explicit app rules outrank automatic CPU behavior. Performance rules latch until the tracked process exits." FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border CornerRadius="10" Background="#0DD88CFF" BorderBrush="#35D88CFF" BorderThickness="1" Padding="10,7">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="PERFORMANCE LOCK" FontSize="9" CharacterSpacing="70"/><TextBlock Grid.Column="1" Text="game / heavy app · held to lifecycle exit" FontSize="9" Opacity="0.42" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/></Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="10" Background="#0D6EA8FF" BorderBrush="#356EA8FF" BorderThickness="1" Padding="10,7">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="BALANCED" FontSize="9" CharacterSpacing="70"/><TextBlock Grid.Column="1" Text="explicit workload · held while process exists" FontSize="9" Opacity="0.42" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/></Grid>
            </Border>
        </Grid>

        <CommandBar Grid.Row="2" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" IsOpen="False">
            <AppBarButton Label="Capture foreground as game" Click="OnRememberGame"/>
            <AppBarButton Label="Capture foreground as Balanced" Click="OnRememberBalanced"/>
        </CommandBar>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="RulesRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="260" MinItemHeight="126" MinRowSpacing="10" MinColumnSpacing="10" ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RuleCardBorder" CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="12">
                            <Grid RowSpacing="7">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="#12FFFFFF"><TextBlock Text="{Binding Mode}" FontSize="9"/></Border></Grid>
                                <TextBlock Grid.Row="1" Text="{Binding ExecutablePath}" FontSize="10" Opacity="0.4" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7"><Button Content="Performance" Tag="{Binding}" Click="OnSetPerformanceFromCard" Padding="8,3"/><Button Content="Balanced" Tag="{Binding}" Click="OnSetBalancedFromCard" Padding="8,3"/><Button Content="Remove" Tag="{Binding}" Click="OnRemoveFromCard" Padding="8,3"/></StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="10" Opacity="0.45"/>
    </Grid>
</Page>
