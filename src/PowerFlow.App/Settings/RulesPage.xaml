<Page
    x:Class="PowerFlow.App.Settings.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="42,34" Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="RULES" FontSize="12" CharacterSpacing="240" Opacity="0.48"/>
            <TextBlock Text="Apps that hold the line" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="Explicit rules outrank automatic CPU behavior. Performance rules become hard game-style latches until the tracked process exits." FontSize="14" Opacity="0.62" TextWrapping="Wrap" MaxWidth="760"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,2">
                <Button Content="Remember foreground as Game" Click="OnRememberGame"/>
                <Button Content="Remember foreground as Balanced" Click="OnRememberBalanced"/>
                <Button Content="Set selected → Performance" Click="OnSetPerformance"/>
                <Button Content="Set selected → Balanced" Click="OnSetBalanced"/>
                <Button Content="Remove selected" Click="OnRemoveSelected"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.48"/>
            <ListView x:Name="RulesList" SelectionMode="Single" MinHeight="300" Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Mode}" FontSize="13" Opacity="0.7"/>
                            <TextBlock Grid.Column="2" Text="{Binding ExecutablePath}" FontSize="12" Opacity="0.42" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Tip: launch an unlisted game, Alt-Tab here, then choose “Remember foreground as Game.”" FontSize="12" Opacity="0.4"/>
        </StackPanel>
    </ScrollViewer>
</Page>
