<Page
    x:Class="PowerFlow.App.Settings.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="34,26" Spacing="16" MaxWidth="1080" HorizontalAlignment="Left">
            <TextBlock Text="RULES" FontSize="11" CharacterSpacing="220" Opacity="0.46"/>
            <TextBlock Text="Visual policy routing" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="App rules sit above CPU automation. Performance rules are lifecycle latches: once the app/game is detected, PowerFlow does not demote until that process family is actually gone." FontSize="13" Opacity="0.6" TextWrapping="Wrap" MaxWidth="880"/>

            <Grid ColumnSpacing="12" Margin="0,6,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border CornerRadius="13" Background="#0DD88CFF" BorderBrush="#35D88CFF" BorderThickness="1" Padding="14"><StackPanel Spacing="4"><TextBlock Text="PERFORMANCE LOCK" FontSize="11" CharacterSpacing="80"/><TextBlock Text="game / heavy app" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Locks High Performance until process lifecycle ends" FontSize="11" Opacity="0.52"/></StackPanel></Border>
                <Border Grid.Column="1" CornerRadius="13" Background="#0D6EA8FF" BorderBrush="#356EA8FF" BorderThickness="1" Padding="14"><StackPanel Spacing="4"><TextBlock Text="BALANCED" FontSize="11" CharacterSpacing="80"/><TextBlock Text="explicit workload" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Holds Balanced while the selected process is present" FontSize="11" Opacity="0.52"/></StackPanel></Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,5,0,0">
                <Button Content="Foreground → Performance" Click="OnRememberGame"/>
                <Button Content="Foreground → Balanced" Click="OnRememberBalanced"/>
                <Button Content="Selected → Performance" Click="OnSetPerformance"/>
                <Button Content="Selected → Balanced" Click="OnSetBalanced"/>
                <Button Content="Remove selected" Click="OnRemoveSelected"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.48"/>

            <ListView x:Name="RulesList" SelectionMode="Single" MinHeight="320" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RuleCardBorder" CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="15" Margin="0,0,0,10">
                            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="PROCESS RULE" FontSize="9" CharacterSpacing="80" Opacity="0.38"/></StackPanel>
                                <Border Grid.Column="1" CornerRadius="10" Background="#14FFFFFF" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{Binding Mode}" FontSize="11" HorizontalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding ExecutablePath}" FontSize="11" Opacity="0.48" TextTrimming="CharacterEllipsis"/><TextBlock Text="Tracks child processes · releases on lifecycle exit" FontSize="10" Opacity="0.3"/></StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Tip: launch an unlisted game, Alt-Tab here, then capture the foreground process." FontSize="11" Opacity="0.38"/>
        </StackPanel>
    </ScrollViewer>
</Page>
