<Page
    x:Class="PowerFlow.App.Settings.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
                <TextBlock Text="WORKLOADS" FontSize="11" CharacterSpacing="180" Opacity="0.45"/>
                <TextBlock Text="App importance" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Tell Auto which apps may earn more CPU response. Nothing here throttles or suspends an app." FontSize="12" Opacity="0.52" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Add app" Click="OnAddAppRule" Padding="12,5" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <Border CornerRadius="8" Background="#146EA8FF" BorderBrush="#356EA8FF" BorderThickness="1" Padding="8,4"><TextBlock Text="LOW · EFFICIENCY ONLY" FontSize="11"/></Border>
            <Border CornerRadius="8" Background="#14D88CFF" BorderBrush="#35D88CFF" BorderThickness="1" Padding="8,4"><TextBlock Text="NORMAL · QUALIFIED BOOST" FontSize="11"/></Border>
            <Border CornerRadius="8" Background="#18FF9A45" BorderBrush="#40FF9A45" BorderThickness="1" Padding="8,4"><TextBlock Text="HIGH · FAST BOOST" FontSize="11"/></Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="RulesRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="270" MinItemHeight="116" MinRowSpacing="7" MinColumnSpacing="7" ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="10">
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Padding="7,2" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}"><TextBlock Text="{Binding ImportanceLabel}" FontSize="11" FontWeight="SemiBold"/></Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding ExecutablePath}" FontSize="11" Opacity="0.42" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Text="{Binding PolicyLabel}" FontSize="11" Opacity="0.68" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Change importance" Tag="{Binding Rule}" Click="OnEditImportanceFromCard" Padding="9,4" FontSize="12"/>
                                    <Button Content="Remove" Tag="{Binding Rule}" Click="OnRemoveFromCard" Padding="9,4" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="11" Opacity="0.50"/>

        <ContentDialog x:Name="AppPickerDialog" Title="Add app" PrimaryButtonText="Add" CloseButtonText="Cancel" DefaultButton="Primary" PrimaryButtonClick="OnAppPickerPrimary">
            <Grid MinWidth="320" MaxWidth="560" MaxHeight="390" RowSpacing="9" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="AppSearchBox" PlaceholderText="Search running apps" TextChanged="OnAppSearchChanged"/>
                    <ComboBox x:Name="NewAppImportanceBox" Grid.Column="1" SelectedIndex="1" AutomationProperties.Name="New app importance">
                        <ComboBoxItem Content="Low"/><ComboBoxItem Content="Normal"/><ComboBoxItem Content="High"/>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Browse…" Click="OnBrowseExecutable" Padding="10,4"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="Running user apps" FontSize="11" Opacity="0.45"/>
                <ListView x:Name="AppPickerList" Grid.Row="2" SelectionMode="Single" MinHeight="140" MaxHeight="260" VerticalAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Width="22" Height="22" Source="{Binding Icon}" Stretch="Uniform" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ExecutablePath}" FontSize="11" Opacity="0.45" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ContentDialog>

        <ContentDialog x:Name="ImportanceDialog" Title="App importance" PrimaryButtonText="Save" CloseButtonText="Cancel" DefaultButton="Primary" PrimaryButtonClick="OnImportancePrimary">
            <StackPanel MinWidth="340" MaxWidth="520" Spacing="10">
                <TextBlock x:Name="ImportanceAppText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <ComboBox x:Name="AppImportanceBox" SelectedIndex="1" AutomationProperties.Name="App importance">
                    <ComboBoxItem Content="LOW · efficiency only"/>
                    <ComboBoxItem Content="NORMAL · qualified boost"/>
                    <ComboBoxItem Content="HIGH · fast boost"/>
                </ComboBox>
                <TextBlock Text="Low cannot promote Auto into Boost by itself. Normal can earn Boost after sustained demand. High can earn it faster for latency-sensitive work." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>