<Page
    x:Class="PowerFlow.App.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="20,14" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
            <StackPanel Spacing="1">
                <TextBlock Text="SETTINGS" FontSize="11" CharacterSpacing="180" Foreground="{ThemeResource PowerFlowTextMutedBrush}"/>
                <TextBlock Text="PowerFlow preferences" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Appearance and startup behavior. CPU policy is owned by Auto, Workloads, and the fixed PowerFlow profiles." FontSize="12" Foreground="{ThemeResource PowerFlowTextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid ColumnSpacing="14" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Theme" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="220" SelectionChanged="OnThemeSelectionChanged"><ComboBoxItem Content="Follow Windows" Tag="System"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/></ComboBox>
                <TextBlock Grid.Row="1" Text="Reduced motion" VerticalAlignment="Center"/>
                <ComboBox x:Name="ReducedMotionBox" Grid.Row="1" Grid.Column="1" Width="220"><ComboBoxItem Content="Follow Windows" Tag="Auto"/><ComboBoxItem Content="On" Tag="On"/><ComboBoxItem Content="Off" Tag="Off"/></ComboBox>
                <TextBlock Grid.Row="2" Text="Start with Windows" VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="StartupToggle" Grid.Row="2" Grid.Column="1" OnContent="On" OffContent="Off"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Save settings" Click="OnSave"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource PowerFlowTextMutedBrush}"/></StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
