<Page
    x:Class="PowerFlow.App.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="20,14" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Spacing="0"><TextBlock Text="SETTINGS" FontSize="9" CharacterSpacing="180" Opacity="0.45"/><TextBlock Text="Policy &amp; appearance" FontSize="20" FontWeight="SemiBold"/></StackPanel>
            <Grid Margin="0,4,0,0" ColumnSpacing="14" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Resting state" VerticalAlignment="Center"/><ComboBox x:Name="RestingStateBox" Grid.Column="1" Width="240"><ComboBoxItem Content="Power Saver" Tag="PowerSaver"/><ComboBoxItem Content="Balanced" Tag="Balanced"/></ComboBox>
                <TextBlock Grid.Row="1" Text="Promote above CPU %" VerticalAlignment="Center"/><NumberBox x:Name="PromotionThresholdBox" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="2" Text="Promotion hold (seconds)" VerticalAlignment="Center"/><NumberBox x:Name="PromotionWindowBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="60" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="3" Text="Quiet below CPU %" VerticalAlignment="Center"/><NumberBox x:Name="QuietThresholdBox" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="4" Text="Quiet hold (seconds)" VerticalAlignment="Center"/><NumberBox x:Name="QuietWindowBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="300" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="5" Text="Post-game cooldown (seconds)" VerticalAlignment="Center"/><NumberBox x:Name="CooldownBox" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="120" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="6" Text="Reduced motion" VerticalAlignment="Center"/><ComboBox x:Name="ReducedMotionBox" Grid.Row="6" Grid.Column="1" Width="240"><ComboBoxItem Content="Follow Windows" Tag="Auto"/><ComboBoxItem Content="On" Tag="On"/><ComboBoxItem Content="Off" Tag="Off"/></ComboBox>
                <TextBlock Grid.Row="7" Text="Theme" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Grid.Row="7" Grid.Column="1" Width="240" SelectionChanged="OnThemeSelectionChanged"><ComboBoxItem Content="Follow Windows" Tag="System"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/></ComboBox>
            </Grid>

            <Grid ColumnSpacing="14" RowSpacing="8" Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Power Saver profile" VerticalAlignment="Center"/><ComboBox x:Name="SaverPlanBox" Grid.Column="1" Width="360" DisplayMemberPath="Name"/>
                <TextBlock Grid.Row="1" Text="Balanced profile" VerticalAlignment="Center"/><ComboBox x:Name="BalancedPlanBox" Grid.Row="1" Grid.Column="1" Width="360" DisplayMemberPath="Name"/>
                <TextBlock Grid.Row="2" Text="Performance profile" VerticalAlignment="Center"/><ComboBox x:Name="PerformancePlanBox" Grid.Row="2" Grid.Column="1" Width="360" DisplayMemberPath="Name"/>
            </Grid>
            <TextBlock Text="PowerFlow lists installed Windows power plans here. “Windows default” uses the built-in Saver/Balanced/High Performance IDs." FontSize="9.5" Opacity="0.45" TextWrapping="Wrap" MaxWidth="620"/>

            <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,2,0,0"><ToggleSwitch x:Name="StartupToggle" Header="Start with Windows" OnContent="On" OffContent="Off"/><ToggleSwitch x:Name="SafeRestToggle" Header="Rest in Balanced" OnContent="Balanced" OffContent="Saver"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Save settings" Click="OnSave"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="10" Opacity="0.5"/></StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
