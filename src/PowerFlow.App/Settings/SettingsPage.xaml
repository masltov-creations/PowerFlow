<Page
    x:Class="PowerFlow.App.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="42,34" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="SETTINGS" FontSize="12" CharacterSpacing="240" Opacity="0.48"/>
            <TextBlock Text="Policy, safety &amp; motion" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="PowerFlow changes which Windows plan is active; it never rewrites the hidden processor settings inside those plans." FontSize="14" Opacity="0.62" TextWrapping="Wrap"/>

            <Grid Margin="0,12,0,0" ColumnSpacing="18" RowSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Resting state" VerticalAlignment="Center"/><ComboBox x:Name="RestingStateBox" Grid.Column="1" Width="220"><ComboBoxItem Content="Power Saver" Tag="PowerSaver"/><ComboBoxItem Content="Balanced" Tag="Balanced"/></ComboBox>
                <TextBlock Grid.Row="1" Text="Promote above CPU %" VerticalAlignment="Center"/><NumberBox x:Name="PromotionThresholdBox" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="2" Text="Promotion hold (seconds)" VerticalAlignment="Center"/><NumberBox x:Name="PromotionWindowBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="60" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="3" Text="Quiet below CPU %" VerticalAlignment="Center"/><NumberBox x:Name="QuietThresholdBox" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="4" Text="Quiet hold (seconds)" VerticalAlignment="Center"/><NumberBox x:Name="QuietWindowBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="300" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="5" Text="Post-game cooldown (seconds)" VerticalAlignment="Center"/><NumberBox x:Name="CooldownBox" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="120" SpinButtonPlacementMode="Compact"/>
                <TextBlock Grid.Row="6" Text="Reduced motion" VerticalAlignment="Center"/><ComboBox x:Name="ReducedMotionBox" Grid.Row="6" Grid.Column="1" Width="220"><ComboBoxItem Content="Follow Windows" Tag="Auto"/><ComboBoxItem Content="On" Tag="On"/><ComboBoxItem Content="Off" Tag="Off"/></ComboBox>
            </Grid>

            <ToggleSwitch x:Name="StartupToggle" Header="Start with Windows" OnContent="Enabled" OffContent="Disabled" Margin="0,6,0,0"/>
            <ToggleSwitch x:Name="SafeRestToggle" Header="Development safety: rest in Balanced" OnContent="Balanced" OffContent="Power Saver"/>

            <TextBlock Text="PLAN MAPPINGS · leave blank for Windows defaults" FontSize="11" CharacterSpacing="90" Opacity="0.42" Margin="0,14,0,0"/>
            <TextBox x:Name="SaverPlanBox" Header="Power Saver plan GUID" PlaceholderText="Windows default"/>
            <TextBox x:Name="BalancedPlanBox" Header="Balanced plan GUID" PlaceholderText="Windows default"/>
            <TextBox x:Name="PerformancePlanBox" Header="High Performance plan GUID" PlaceholderText="Windows default"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0"><Button Content="Save settings" Click="OnSave"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.5"/></StackPanel>
            <TextBlock Text="Thresholds, timing, resting state, rules, and startup preference apply immediately. Plan mappings take effect on the next transition that uses them." FontSize="12" Opacity="0.4" TextWrapping="Wrap" MaxWidth="720"/>
        </StackPanel>
    </ScrollViewer>
</Page>

