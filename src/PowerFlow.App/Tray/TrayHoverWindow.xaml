<Window
    x:Class="PowerFlow.App.Tray.TrayHoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root"
            Background="{ThemeResource PowerFlowHoverBrush}"
            BorderBrush="{ThemeResource PowerFlowCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="15,13"
            Tapped="OnRootTapped">
        <Grid RowSpacing="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="96"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="TrayCpuBrushSource" Background="{ThemeResource PowerFlowCpuBrush}"/>
                <Border x:Name="TrayPowerBrushSource" Background="{ThemeResource PowerFlowPowerBrush}"/>
                <Border x:Name="TrayNowBrushSource" Background="{ThemeResource PowerFlowNowBrush}"/>
                <Border x:Name="TraySaverBrushSource" Background="{ThemeResource PowerFlowStateSaverBrush}"/>
                <Border x:Name="TrayBalancedBrushSource" Background="{ThemeResource PowerFlowStateBalancedBrush}"/>
                <Border x:Name="TrayPerformanceBrushSource" Background="{ThemeResource PowerFlowStatePerformanceBrush}"/>
                <Border x:Name="TrayTrackBrushSource" Background="{ThemeResource PowerFlowTrackBrush}"/>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="0">
                    <TextBlock Text="POWERFLOW" FontSize="11" CharacterSpacing="160" Opacity="0.50"/>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock x:Name="StateText" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DirectionText" FontSize="11" Opacity="0.48" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Padding="8,3" CornerRadius="9" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeBadge" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="16" Margin="2,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="CPU" FontSize="11" Opacity="0.44"/><TextBlock x:Name="CpuText" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowCpuBrush}"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="PACKAGE" FontSize="11" Opacity="0.44"/><TextBlock x:Name="WattsText" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowPowerBrush}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="GHz" FontSize="11" Opacity="0.44"/><TextBlock x:Name="FrequencyText" FontSize="16" FontWeight="SemiBold"/></StackPanel>
            </Grid>

            <Border Grid.Row="2" CornerRadius="12" Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="9,6">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SaverNode" Text="SAVER" FontSize="11" Foreground="{ThemeResource PowerFlowStateSaverBrush}"/>
                        <TextBlock x:Name="BalancedNode" Grid.Column="1" Text="BALANCED" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource PowerFlowStateBalancedBrush}"/>
                        <TextBlock x:Name="PerformanceNode" Grid.Column="2" Text="PERFORMANCE" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource PowerFlowStatePerformanceBrush}"/>
                        <TextBlock x:Name="TrayNowLabel" Grid.Column="3" Text="NOW" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </Grid>
                    <Canvas x:Name="TrayTrajectoryCanvas" Grid.Row="1" Height="64" SizeChanged="OnTrajectorySizeChanged"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="NEXT" FontSize="11" CharacterSpacing="70" Opacity="0.42" VerticalAlignment="Center"/>
                <TextBlock x:Name="NextAction" Grid.Column="1" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Grid.Row="4" Text="CLICK TO OPEN POWERFLOW  →" FontSize="11" CharacterSpacing="55" Opacity="0.34" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
