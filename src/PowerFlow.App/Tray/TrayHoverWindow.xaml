<Window
    x:Class="PowerFlow.App.Tray.TrayHoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root" Background="{ThemeResource PowerFlowHoverBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" CornerRadius="17" Padding="11,9" Tapped="OnRootTapped">
        <Grid RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="62"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="TrayCpuBrushSource" Background="{ThemeResource PowerFlowCpuBrush}"/>
                <Border x:Name="TrayPowerBrushSource" Background="{ThemeResource PowerFlowPowerBrush}"/>
                <Border x:Name="TrayNowBrushSource" Background="{ThemeResource PowerFlowNowBrush}"/>
                <Border x:Name="TraySaverBrushSource" Background="{ThemeResource PowerFlowStateSaverBrush}"/>
                <Border x:Name="TrayBalancedBrushSource" Background="{ThemeResource PowerFlowStateBalancedBrush}"/>
                <Border x:Name="TrayPerformanceBrushSource" Background="{ThemeResource PowerFlowStatePerformanceBrush}"/>
                <Border x:Name="TrayTrackBrushSource" Background="{ThemeResource PowerFlowTrackBrush}"/>
            </Grid>
            <Grid ColumnSpacing="7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="0">
                    <TextBlock Text="POWERFLOW" FontSize="11" CharacterSpacing="150" Opacity="0.48"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="StateText" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DirectionText" FontSize="11" Opacity="0.48" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="CompactTelemetryLine" FontSize="11" Opacity="0.70"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Center"><TextBlock x:Name="ModeBadge" FontSize="11" FontWeight="SemiBold"/></Border>
            </Grid>
            <Border Grid.Row="1" CornerRadius="10" Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="7,4">
                <Grid RowSpacing="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SaverNode" Text="SAVER" FontSize="11" Foreground="{ThemeResource PowerFlowStateSaverBrush}"/>
                        <TextBlock x:Name="BalancedNode" Grid.Column="1" Text="BALANCED" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource PowerFlowStateBalancedBrush}"/>
                        <TextBlock x:Name="PerformanceNode" Grid.Column="2" Text="PERF" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource PowerFlowStatePerformanceBrush}"/>
                        <TextBlock x:Name="TrayNowLabel" Grid.Column="3" Text="NOW" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
                    </Grid>
                    <Canvas x:Name="TrayTrajectoryCanvas" Grid.Row="1" Height="38" SizeChanged="OnTrajectorySizeChanged"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnSpacing="7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="NEXT" FontSize="11" CharacterSpacing="60" Opacity="0.42" VerticalAlignment="Center"/>
                <TextBlock x:Name="NextAction" Grid.Column="1" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="OPEN ›" FontSize="11" CharacterSpacing="45" Opacity="0.42" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>