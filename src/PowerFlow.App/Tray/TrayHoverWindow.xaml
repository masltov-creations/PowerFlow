<Window
    x:Class="PowerFlow.App.Tray.TrayHoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root"
            Background="{ThemeResource PowerFlowHoverBrush}"
            BorderBrush="{ThemeResource PowerFlowCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="14,12"
            Tapped="OnRootTapped">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="0">
                    <TextBlock Text="POWERFLOW" FontSize="11" CharacterSpacing="150" Opacity="0.52"/>
                    <TextBlock x:Name="StateText" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="8,3" CornerRadius="9" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeBadge" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" CornerRadius="11" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="10,7">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="CPU" FontSize="11" Opacity="0.5"/><TextBlock x:Name="CpuText" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="PACKAGE" FontSize="11" Opacity="0.5"/><TextBlock x:Name="WattsText" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="GHz" FontSize="11" Opacity="0.5"/><TextBlock x:Name="FrequencyText" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Canvas x:Name="TraySparkline" Height="58" SizeChanged="OnSparklineSizeChanged"/>
                <TextBlock Text="LIVE WHILE OPEN" FontSize="10" Opacity="0.3" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="NEXT" FontSize="11" CharacterSpacing="70" Opacity="0.45" VerticalAlignment="Center"/>
                <TextBlock x:Name="NextAction" Grid.Column="1" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
