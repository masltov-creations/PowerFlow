    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="14">
            <Canvas x:Name="PlotCanvas" MinHeight="310" SizeChanged="OnSizeChanged"/>
        </Border>
    </Grid>
</UserControl>
