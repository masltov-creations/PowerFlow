<UserControl
    x:Class="PowerFlow.App.Dashboard.TelemetryGraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="12">
            <Canvas x:Name="PlotCanvas" MinHeight="220" SizeChanged="OnSizeChanged" PointerMoved="OnPointerMoved" PointerExited="OnPointerExited"/>
        </Border>
        <Border x:Name="HoverCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Padding="8,5" CornerRadius="8" Background="#E6161D27" BorderBrush="#38FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <TextBlock x:Name="HoverText" FontSize="9"/>
        </Border>
    </Grid>
</UserControl>
