<UserControl
    x:Class="PowerFlow.App.Dashboard.TelemetryGraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid>
        <Border Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" CornerRadius="10">
            <Canvas x:Name="PlotCanvas" MinHeight="220" SizeChanged="OnSizeChanged"/>
        </Border>
        <Canvas x:Name="InteractionCanvas" MinHeight="220" Background="Transparent" PointerMoved="OnPointerMoved" PointerExited="OnPointerExited">
            <primitives:Thumb x:Name="PromoteThumb" Height="20" Opacity="0.01" AutomationProperties.Name="Promotion threshold" DragStarted="OnPromoteDragStarted" DragDelta="OnPromoteDragDelta" DragCompleted="OnPromoteDragCompleted"/>
            <primitives:Thumb x:Name="QuietThumb" Height="20" Opacity="0.01" AutomationProperties.Name="Quiet threshold" DragStarted="OnQuietDragStarted" DragDelta="OnQuietDragDelta" DragCompleted="OnQuietDragCompleted"/>
            <Line x:Name="PromoteRail" Stroke="{ThemeResource PowerFlowAutoAccentBrush}" StrokeThickness="1.4" StrokeDashArray="5,4" IsHitTestVisible="False"/>
            <Line x:Name="QuietRail" Stroke="{ThemeResource PowerFlowSaverAccentBrush}" StrokeThickness="1.4" StrokeDashArray="5,4" IsHitTestVisible="False"/>
            <Line x:Name="PromoteHitRail" Stroke="Transparent" StrokeThickness="18" IsHitTestVisible="False"/>
            <Line x:Name="QuietHitRail" Stroke="Transparent" StrokeThickness="18" IsHitTestVisible="False"/>
            <Ellipse x:Name="PromoteHandle" Width="11" Height="11" Fill="{ThemeResource PowerFlowAutoAccentBrush}" Stroke="#A0FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
            <Ellipse x:Name="QuietHandle" Width="11" Height="11" Fill="{ThemeResource PowerFlowSaverAccentBrush}" Stroke="#A0FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
            <TextBlock x:Name="PromoteLabel" FontSize="11" Foreground="{ThemeResource PowerFlowAutoAccentBrush}" IsHitTestVisible="False"/>
            <TextBlock x:Name="QuietLabel" FontSize="11" Foreground="{ThemeResource PowerFlowSaverAccentBrush}" IsHitTestVisible="False"/>
            <Line x:Name="HoverLine" Stroke="#6699AABB" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Ellipse x:Name="CpuHoverDot" Width="8" Height="8" Fill="{ThemeResource PowerFlowSaverAccentBrush}" Stroke="#A0FFFFFF" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Ellipse x:Name="PowerHoverDot" Width="8" Height="8" Fill="{ThemeResource PowerFlowPowerBrush}" Stroke="#A0FFFFFF" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Canvas>
        <Border x:Name="HoverCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" Padding="7,4" CornerRadius="7" Background="{ThemeResource PowerFlowHoverBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" IsHitTestVisible="False"><TextBlock x:Name="HoverText" FontSize="11"/></Border>
    </Grid>
</UserControl>
