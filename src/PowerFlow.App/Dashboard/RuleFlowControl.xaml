<UserControl
    x:Class="PowerFlow.App.Dashboard.RuleFlowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ItemsControl x:Name="RulesItems">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="13" Margin="0,0,0,10">
                        <StackPanel Spacing="6">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="11" CharacterSpacing="80" Opacity="0.68"/><Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="#12FFFFFF"><TextBlock Text="{Binding Status}" FontSize="9" CharacterSpacing="70"/></Border></Grid>
                            <TextBlock Text="{Binding Condition}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="→" Opacity="0.42"/><TextBlock Text="{Binding Target}" FontSize="11" CharacterSpacing="65"/></StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
