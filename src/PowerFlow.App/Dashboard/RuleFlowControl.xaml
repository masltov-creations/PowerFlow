<UserControl
    x:Class="PowerFlow.App.Dashboard.RuleFlowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ItemsRepeater x:Name="RulesItems">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="66" MinRowSpacing="6" MinColumnSpacing="6" ItemsStretch="Fill"/>
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10" Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="9" Margin="0,0,0,2">
                        <StackPanel Spacing="3">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="9" CharacterSpacing="65" Opacity="0.62"/><Border Grid.Column="1" Padding="6,1" CornerRadius="7" Background="#12FFFFFF"><TextBlock Text="{Binding Status}" FontSize="8" CharacterSpacing="55"/></Border></Grid>
                            <TextBlock Text="{Binding Condition}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="→" Opacity="0.38" FontSize="9"/><TextBlock Text="{Binding Target}" FontSize="9" CharacterSpacing="55"/></StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </Grid>
</UserControl>
