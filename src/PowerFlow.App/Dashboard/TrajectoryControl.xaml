<UserControl
    x:Class="PowerFlow.App.Dashboard.TrajectoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard">
    <Grid x:Name="Root" RowSpacing="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="AutoNode" Content="AUTO" FontSize="12" Padding="12,5" Click="OnAutoNode" AutomationProperties.Name="Automatic power policy"/>
                <ToggleButton x:Name="SaverNode" Content="SAVER" FontSize="12" Padding="12,5" Click="OnSaverNode" AutomationProperties.Name="Lock Power Saver"/>
                <ToggleButton x:Name="BalancedNode" Content="BALANCED" FontSize="12" Padding="12,5" Click="OnBalancedNode" AutomationProperties.Name="Lock Balanced"/>
                <ToggleButton x:Name="PerformanceNode" Content="PERFORMANCE" FontSize="12" Padding="12,5" Click="OnPerformanceNode" AutomationProperties.Name="Lock High Performance"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="Range60Button" Content="60s" FontSize="11" Padding="8,3" IsChecked="True" Click="OnRange60"/>
                <ToggleButton x:Name="Range120Button" Content="2m" FontSize="11" Padding="8,3" Click="OnRange120"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Height="18">
            <Border Background="{ThemeResource PowerFlowTrackBrush}" CornerRadius="5" Opacity="0.75"/>
            <Canvas x:Name="StateBandCanvas" SizeChanged="OnStateBandSizeChanged" IsHitTestVisible="False"/>
            <TextBlock x:Name="StateBandLabel" FontSize="11" Opacity="0.54" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="2" CornerRadius="12" Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="7">
            <dash:TelemetryGraphControl x:Name="Graph" MinHeight="320"/>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Padding="8,4" CornerRadius="9" Background="{ThemeResource PowerFlowSubtleBrush}">
                <TextBlock x:Name="NowText" Text="NOW" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <TextBlock x:Name="NextActionText" Grid.Column="1" FontSize="12" Opacity="0.72" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DirectionText" Grid.Column="2" FontSize="11" Opacity="0.48" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
