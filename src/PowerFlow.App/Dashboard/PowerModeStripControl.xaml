<UserControl
    x:Class="PowerFlow.App.Dashboard.PowerModeStripControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Border Padding="6,2" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Center">
            <TextBlock x:Name="ModeAuthorityText" Text="AUTO" FontSize="11" FontWeight="SemiBold"/>
        </Border>
        <ToggleButton x:Name="AutoModeButton" Content="AUTO" Padding="8,4" MinWidth="48" Click="OnAutoClicked" AutomationProperties.Name="Automatic power mode" ToolTipService.ToolTip="PowerFlow controls the Windows power plan automatically."/>
        <ToggleButton x:Name="SaverModeButton" Content="SAVER" Padding="8,4" MinWidth="52" Click="OnSaverClicked" AutomationProperties.Name="Windows Power Saver mode" ToolTipService.ToolTip="Switch Windows to the configured Power Saver plan and hold it manually."/>
        <ToggleButton x:Name="BalancedModeButton" Content="BALANCED" Padding="8,4" MinWidth="70" Click="OnBalancedClicked" AutomationProperties.Name="Windows Balanced mode" ToolTipService.ToolTip="Switch Windows to the configured Balanced plan and hold it manually."/>
        <ToggleButton x:Name="PerformanceModeButton" Content="PERFORMANCE" Padding="8,4" MinWidth="88" Click="OnPerformanceClicked" AutomationProperties.Name="Windows High Performance mode" ToolTipService.ToolTip="Switch Windows to the configured High Performance plan and hold it manually."/>
    </StackPanel>
</UserControl>