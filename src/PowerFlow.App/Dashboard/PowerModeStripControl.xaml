<UserControl
    x:Class="PowerFlow.App.Dashboard.PowerModeStripControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Border Padding="6,2" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Center">
            <TextBlock x:Name="ModeAuthorityText" Text="AUTO" FontSize="11" FontWeight="SemiBold"/>
        </Border>
        <ToggleButton x:Name="AutoModeButton" Content="AUTO" Padding="8,4" MinWidth="48" Click="OnAutoClicked" AutomationProperties.Name="Automatic PowerFlow mode" ToolTipService.ToolTip="PowerFlow chooses the operating envelope automatically."/>
        <ToggleButton x:Name="SaverModeButton" Content="SAVER" Padding="8,4" MinWidth="52" Click="OnSaverClicked" AutomationProperties.Name="PowerFlow Saver mode" ToolTipService.ToolTip="Low readiness floor. Boost is disabled and sustained demand must prove itself before more capacity is allowed."/>
        <ToggleButton x:Name="BalancedModeButton" Content="BAL" Padding="8,4" MinWidth="48" Click="OnBalancedClicked" AutomationProperties.Name="PowerFlow Balanced mode" ToolTipService.ToolTip="Adaptive equilibrium: a modest readiness floor with efficient boost and room to scale."/>
        <ToggleButton x:Name="PerformanceModeButton" Content="PERF" Padding="8,4" MinWidth="52" Click="OnPerformanceClicked" AutomationProperties.Name="PowerFlow Performance mode" ToolTipService.ToolTip="High readiness: most cores are kept available and aggressive boost is ready."/>
        <ToggleButton x:Name="UltraModeButton" Content="ULTRA" Padding="8,4" MinWidth="54" Click="OnUltraClicked" AutomationProperties.Name="PowerFlow Ultra mode" ToolTipService.ToolTip="Fully pre-armed: all cores available using the High Performance plan."/>
    </StackPanel>
</UserControl>