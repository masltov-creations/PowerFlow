<UserControl
    x:Class="PowerFlow.App.Dashboard.PowerModeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="CurrentChipLayer" Visibility="Collapsed" ColumnSpacing="7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border CornerRadius="10" Padding="9,5" Background="{ThemeResource PowerFlowSurfaceElevatedBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1">
                <TextBlock Text="{Binding StateLabel}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Border Grid.Column="1" CornerRadius="9" Padding="7,4" Background="{ThemeResource PowerFlowAutoSurfaceBrush}" BorderBrush="{ThemeResource PowerFlowAutoAccentBrush}" BorderThickness="1">
                <TextBlock Text="{Binding ControlBadgeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowAutoAccentBrush}"/>
            </Border>
        </Grid>

        <Grid x:Name="SegmentedLayer" Visibility="Collapsed" ColumnSpacing="5">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0" Content="SAVER" FontSize="11" FontWeight="SemiBold" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsChecked="{Binding IsPowerSaverSelected, Mode=OneWay}" IsEnabled="{Binding ManualModeEnabled, Mode=OneWay}" Click="OnSaverClicked"/>
            <ToggleButton Grid.Column="1" Content="BALANCED" FontSize="11" FontWeight="SemiBold" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsChecked="{Binding IsBalancedSelected, Mode=OneWay}" IsEnabled="{Binding ManualModeEnabled, Mode=OneWay}" Click="OnBalancedClicked"/>
            <ToggleButton Grid.Column="2" Content="PERFORMANCE" FontSize="11" FontWeight="SemiBold" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsChecked="{Binding IsPerformanceSelected, Mode=OneWay}" IsEnabled="{Binding ManualModeEnabled, Mode=OneWay}" Click="OnPerformanceClicked"/>
            <ToggleButton Grid.Column="3" Content="AUTO" FontSize="11" FontWeight="SemiBold" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsChecked="{Binding IsAutoSelected, Mode=OneWay}" Click="OnAutoClicked"/>
        </Grid>

        <Grid x:Name="CardsLayer" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="13,9" CornerRadius="13" Background="{ThemeResource PowerFlowSaverSurfaceBrush}" BorderBrush="{ThemeResource PowerFlowSaverAccentBrush}" BorderThickness="1" IsChecked="{Binding IsPowerSaverSelected, Mode=OneWay}" IsEnabled="{Binding ManualModeEnabled, Mode=OneWay}" Click="OnSaverClicked">
                <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="S" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource PowerFlowSaverAccentBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="POWER SAVER" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Cool · quiet · efficient" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/></StackPanel></Grid>
            </ToggleButton>
            <ToggleButton Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="13,9" CornerRadius="13" Background="{ThemeResource PowerFlowBalancedSurfaceBrush}" BorderBrush="{ThemeResource PowerFlowBalancedAccentBrush}" BorderThickness="1" IsChecked="{Binding IsBalancedSelected, Mode=OneWay}" IsEnabled="{Binding ManualModeEnabled, Mode=OneWay}" Click="OnBalancedClicked">
                <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="B" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource PowerFlowBalancedAccentBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="BALANCED" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Adaptive headroom" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/></StackPanel></Grid>
            </ToggleButton>
            <ToggleButton Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="13,9" CornerRadius="13" Background="{ThemeResource PowerFlowPerformanceSurfaceBrush}" BorderBrush="{ThemeResource PowerFlowPerformanceAccentBrush}" BorderThickness="1" IsChecked="{Binding IsPerformanceSelected, Mode=OneWay}" IsEnabled="{Binding ManualModeEnabled, Mode=OneWay}" Click="OnPerformanceClicked">
                <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="P" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource PowerFlowPerformanceAccentBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="PERFORMANCE" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Maximum headroom" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/></StackPanel></Grid>
            </ToggleButton>
            <ToggleButton Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="13,9" CornerRadius="13" Background="{ThemeResource PowerFlowAutoSurfaceBrush}" BorderBrush="{ThemeResource PowerFlowAutoAccentBrush}" BorderThickness="1" IsChecked="{Binding IsAutoSelected, Mode=OneWay}" Click="OnAutoClicked">
                <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="A" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource PowerFlowAutoAccentBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="AUTO" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding AutoModeDetail}" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/></StackPanel></Grid>
            </ToggleButton>
        </Grid>
    </Grid>
</UserControl>
