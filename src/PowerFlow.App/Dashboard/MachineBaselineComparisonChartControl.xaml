<UserControl
    x:Class="PowerFlow.App.Dashboard.MachineBaselineComparisonChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="250" RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" CornerRadius="10"/>
        <Grid Margin="10,8,10,8">
            <Canvas x:Name="ChartCanvas" SizeChanged="OnChartSizeChanged"/>
            <Border x:Name="EmptyMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,7" CornerRadius="7" Background="{ThemeResource PowerFlowHoverBrush}">
                <TextBlock Text="Run BASELINE MACHINE to build the comparison curves." FontSize="11" Opacity="0.66"/>
            </Border>
        </Grid>
        <StackPanel x:Name="LegendPanel" Grid.Row="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"/>
    </Grid>
</UserControl>