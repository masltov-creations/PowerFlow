<UserControl
    x:Class="PowerFlow.App.Dashboard.FlowFieldControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Height="300" Background="Transparent" Loaded="OnLoaded" Unloaded="OnUnloaded">
        <Viewbox Stretch="Uniform">
            <Canvas Width="1000" Height="300">
                <Path Stroke="#18FFFFFF" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 105,150 C 285,62 410,230 500,150 C 590,70 720,238 895,150"/>
                <Path x:Name="EnergyPath" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 105,150 C 285,62 410,230 500,150 C 590,70 720,238 895,150" Opacity="0.55">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4DE7D3" Offset="0"/>
                            <GradientStop Color="#6EA8FF" Offset="0.5"/>
                            <GradientStop Color="#D88CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <Ellipse x:Name="SaverHalo" Width="118" Height="118" Canvas.Left="46" Canvas.Top="91" Fill="#124DE7D3" Stroke="#604DE7D3" StrokeThickness="2"/>
                <Ellipse x:Name="BalancedHalo" Width="118" Height="118" Canvas.Left="441" Canvas.Top="91" Fill="#126EA8FF" Stroke="#606EA8FF" StrokeThickness="2"/>
                <Ellipse x:Name="PerformanceHalo" Width="118" Height="118" Canvas.Left="836" Canvas.Top="91" Fill="#12D88CFF" Stroke="#60D88CFF" StrokeThickness="2"/>

                <Border x:Name="SaverAnchor" Width="70" Height="70" CornerRadius="35" Canvas.Left="70" Canvas.Top="115" Background="#D9141B20" BorderBrush="#FF4DE7D3" BorderThickness="2">
                    <Border.RenderTransform><CompositeTransform CenterX="35" CenterY="35"/></Border.RenderTransform>
                    <Ellipse Width="18" Height="18" Fill="#FF4DE7D3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="BalancedAnchor" Width="70" Height="70" CornerRadius="35" Canvas.Left="465" Canvas.Top="115" Background="#D9141B20" BorderBrush="#FF6EA8FF" BorderThickness="2">
                    <Border.RenderTransform><CompositeTransform CenterX="35" CenterY="35"/></Border.RenderTransform>
                    <Ellipse Width="18" Height="18" Fill="#FF6EA8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="PerformanceAnchor" Width="70" Height="70" CornerRadius="35" Canvas.Left="860" Canvas.Top="115" Background="#D9141B20" BorderBrush="#FFD88CFF" BorderThickness="2">
                    <Border.RenderTransform><CompositeTransform CenterX="35" CenterY="35"/></Border.RenderTransform>
                    <Ellipse Width="18" Height="18" Fill="#FFD88CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="POWER SAVER" Canvas.Left="56" Canvas.Top="221" Foreground="#D9FFFFFF" FontSize="13" CharacterSpacing="90"/>
                <TextBlock Text="BALANCED" Canvas.Left="461" Canvas.Top="221" Foreground="#D9FFFFFF" FontSize="13" CharacterSpacing="90"/>
                <TextBlock Text="PERFORMANCE" Canvas.Left="842" Canvas.Top="221" Foreground="#D9FFFFFF" FontSize="13" CharacterSpacing="90"/>

                <Border x:Name="Particle01" Width="7" Height="7" CornerRadius="4" Canvas.Left="100" Canvas.Top="129" Background="#CCFFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle02" Width="5" Height="5" CornerRadius="3" Canvas.Left="100" Canvas.Top="140" Background="#AAFFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle03" Width="9" Height="9" CornerRadius="5" Canvas.Left="100" Canvas.Top="151" Background="#E6FFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle04" Width="4" Height="4" CornerRadius="2" Canvas.Left="100" Canvas.Top="164" Background="#99FFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle05" Width="6" Height="6" CornerRadius="3" Canvas.Left="100" Canvas.Top="176" Background="#BFFFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle06" Width="5" Height="5" CornerRadius="3" Canvas.Left="100" Canvas.Top="118" Background="#AAFFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle07" Width="8" Height="8" CornerRadius="4" Canvas.Left="100" Canvas.Top="157" Background="#D9FFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle08" Width="4" Height="4" CornerRadius="2" Canvas.Left="100" Canvas.Top="135" Background="#99FFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle09" Width="6" Height="6" CornerRadius="3" Canvas.Left="100" Canvas.Top="168" Background="#BFFFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
                <Border x:Name="Particle10" Width="5" Height="5" CornerRadius="3" Canvas.Left="100" Canvas.Top="146" Background="#AAFFFFFF"><Border.RenderTransform><CompositeTransform/></Border.RenderTransform></Border>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
