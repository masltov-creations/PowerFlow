<UserControl
    x:Class="PowerFlow.App.Dashboard.HarmonicRing.HarmonicRingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnRootSizeChanged"
    MinWidth="180" MinHeight="180">
    <!-- A single, scalable instrument: no rendering timer and no telemetry acquisition. -->
    <Grid x:Name="RingRoot" Background="Transparent"
          AutomationProperties.Name="PowerFlow harmonic ring live status">
        <Grid x:Name="RingSurface"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="240" Height="240">
            <Canvas x:Name="DrawingSurface" Width="240" Height="240"
                    IsHitTestVisible="False">
                <Ellipse x:Name="AmbientRing" Canvas.Left="11" Canvas.Top="11"
                         Width="218" Height="218"
                         Stroke="#FF294967" StrokeThickness="1.5"/>
                <Ellipse x:Name="InnerRing" Canvas.Left="47" Canvas.Top="47"
                         Width="146" Height="146"
                         Stroke="#994DB5F8" StrokeThickness="1.5"/>
                <Path x:Name="PressureStroke" Stroke="#FF30C4FF"
                      StrokeThickness="4" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="PowerAccent" Stroke="#FFF3AE56"
                      StrokeThickness="3" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
                <Canvas x:Name="CoreTickLayer" IsHitTestVisible="False"/>
            </Canvas>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="2" MaxWidth="180">
                <TextBlock x:Name="AppliedProfileText"
                           Text="APPLIED UNKNOWN" FontSize="10"
                           FontWeight="SemiBold" CharacterSpacing="70"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
                <TextBlock x:Name="ClockText" Text="— GHz"
                           FontSize="29" FontWeight="SemiBold"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="PressureText" Text="—%"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#FF69D3FF"/>
                    <TextBlock x:Name="WattsText" Text="— W"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#FFF5C276"/>
                </StackPanel>
                <TextBlock x:Name="CoresText" Text="CORES — / —"
                           HorizontalAlignment="Center" FontSize="10"
                           Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
                <TextBlock x:Name="TrendText" Text="PRESSURE UNKNOWN"
                           HorizontalAlignment="Center" FontSize="9"
                           FontWeight="SemiBold" CharacterSpacing="40"
                           Foreground="{ThemeResource PowerFlowTextMutedBrush}"/>
                <TextBlock x:Name="UsageText" Text="USAGE NOT MEASURED"
                           HorizontalAlignment="Center" FontSize="9"
                           Foreground="{ThemeResource PowerFlowTextMutedBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
