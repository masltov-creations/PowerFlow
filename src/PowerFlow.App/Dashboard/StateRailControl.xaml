<UserControl
    x:Class="PowerFlow.App.Dashboard.StateRailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="7" Height="44">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="SaverCard" CornerRadius="10" BorderThickness="1" Padding="10,5" Background="#0C4DE7D3" BorderBrush="#314DE7D3"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><TextBlock Text="POWER SAVER" FontSize="9" CharacterSpacing="75"/><TextBlock Text="quiet" FontSize="9" Opacity="0.4"/></StackPanel><Ellipse x:Name="SaverDot" Grid.Column="1" Width="7" Height="7" Fill="#FF4DE7D3" VerticalAlignment="Center"/></Grid></Border>
        <Border x:Name="BalancedCard" Grid.Column="1" CornerRadius="10" BorderThickness="1" Padding="10,5" Background="#0C6EA8FF" BorderBrush="#316EA8FF"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><TextBlock Text="BALANCED" FontSize="9" CharacterSpacing="75"/><TextBlock Text="CPU" FontSize="9" Opacity="0.4"/></StackPanel><Ellipse x:Name="BalancedDot" Grid.Column="1" Width="7" Height="7" Fill="#FF6EA8FF" VerticalAlignment="Center"/></Grid></Border>
        <Border x:Name="PerformanceCard" Grid.Column="2" CornerRadius="10" BorderThickness="1" Padding="10,5" Background="#0CD88CFF" BorderBrush="#31D88CFF"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><TextBlock Text="PERFORMANCE" FontSize="9" CharacterSpacing="75"/><TextBlock x:Name="PerformanceSub" Text="game / manual" FontSize="9" Opacity="0.4"/></StackPanel><Ellipse x:Name="PerformanceDot" Grid.Column="1" Width="7" Height="7" Fill="#FFD88CFF" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
</UserControl>
