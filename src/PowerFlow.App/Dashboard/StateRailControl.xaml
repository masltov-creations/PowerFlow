<UserControl
    x:Class="PowerFlow.App.Dashboard.StateRailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="10" Height="66">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="SaverCard" CornerRadius="12" BorderThickness="1" Padding="14,9" Background="#0C4DE7D3" BorderBrush="#314DE7D3">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="POWER SAVER" FontSize="11" CharacterSpacing="90"/><TextBlock Text="resting / quiet" FontSize="11" Opacity="0.48"/></StackPanel><Ellipse x:Name="SaverDot" Grid.Column="1" Width="9" Height="9" Fill="#FF4DE7D3" VerticalAlignment="Center"/></Grid>
        </Border>
        <Border x:Name="BalancedCard" Grid.Column="1" CornerRadius="12" BorderThickness="1" Padding="14,9" Background="#0C6EA8FF" BorderBrush="#316EA8FF">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BALANCED" FontSize="11" CharacterSpacing="90"/><TextBlock Text="sustained CPU" FontSize="11" Opacity="0.48"/></StackPanel><Ellipse x:Name="BalancedDot" Grid.Column="1" Width="9" Height="9" Fill="#FF6EA8FF" VerticalAlignment="Center"/></Grid>
        </Border>
        <Border x:Name="PerformanceCard" Grid.Column="2" CornerRadius="12" BorderThickness="1" Padding="14,9" Background="#0CD88CFF" BorderBrush="#31D88CFF">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PERFORMANCE" FontSize="11" CharacterSpacing="90"/><TextBlock x:Name="PerformanceSub" Text="game / manual latch" FontSize="11" Opacity="0.48"/></StackPanel><Ellipse x:Name="PerformanceDot" Grid.Column="1" Width="9" Height="9" Fill="#FFD88CFF" VerticalAlignment="Center"/></Grid>
        </Border>
    </Grid>
</UserControl>
