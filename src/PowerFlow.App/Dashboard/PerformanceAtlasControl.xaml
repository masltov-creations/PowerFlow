<UserControl
    x:Class="PowerFlow.App.Dashboard.PerformanceAtlasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AtlasRoot" MinHeight="190">
        <Border Background="{ThemeResource PowerFlowPanelBrush}"
                BorderBrush="{ThemeResource PowerFlowCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"/>
        <Grid Padding="12,10,12,9" RowSpacing="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="PERFORMANCE ATLAS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Opacity="0.72"/>
                    <Border Padding="7,2" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}">
                        <TextBlock x:Name="EvidenceBadge" Text="RESIDENCY" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="X" FontSize="11" Opacity="0.52" VerticalAlignment="Center"/>
                    <ComboBox x:Name="XDimensionSelector" MinWidth="132" FontSize="11" SelectedIndex="0" SelectionChanged="OnDimensionChanged">
                        <ComboBoxItem Content="Package Power" Tag="PackagePower"/>
                        <ComboBoxItem Content="Effective Clock" Tag="EffectiveClock"/>
                        <ComboBoxItem Content="Cores Awake" Tag="ActiveCores"/>
                        <ComboBoxItem Content="CPU Pressure" Tag="CpuPressure"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="Y" FontSize="11" Opacity="0.52" VerticalAlignment="Center"/>
                    <ComboBox x:Name="YDimensionSelector" MinWidth="132" FontSize="11" SelectedIndex="1" SelectionChanged="OnDimensionChanged">
                        <ComboBoxItem Content="Package Power" Tag="PackagePower"/>
                        <ComboBoxItem Content="Effective Clock" Tag="EffectiveClock"/>
                        <ComboBoxItem Content="Cores Awake" Tag="ActiveCores"/>
                        <ComboBoxItem Content="CPU Pressure" Tag="CpuPressure"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" MinHeight="142" ColumnSpacing="5" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="YAxisLabel" Grid.Row="0" Text="EFFECTIVE CLOCK (MHz)" FontSize="11" Opacity="0.58"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <Grid Grid.Column="1" x:Name="AtlasPlotHost" MinWidth="140" MinHeight="130">
                    <Canvas x:Name="AtlasCanvas" SizeChanged="OnSizeChanged" IsHitTestVisible="False"/>
                    <Canvas x:Name="FrontierLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="InteractionLayer" Background="Transparent" PointerPressed="OnPointerPressed"/>
                    <Border x:Name="SelectionCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,5,5,0" Padding="8,5" CornerRadius="7"
                            Background="{ThemeResource PowerFlowHoverBrush}"
                            BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" IsHitTestVisible="False">
                        <TextBlock x:Name="SelectionReadout" FontSize="11" TextWrapping="Wrap" MaxWidth="300"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="XAxisLabel" Grid.Row="1" Grid.Column="1" Text="PACKAGE POWER (W)" FontSize="11" Opacity="0.58"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ResidencySummary" Text="Waiting for operating history" FontSize="11" Opacity="0.52" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="DENSITY = RESIDENCY" FontSize="11" Opacity="0.46"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
