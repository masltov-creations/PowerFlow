<UserControl
    x:Class="PowerFlow.App.Dashboard.PerformanceAtlasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AtlasRoot" MinHeight="240">
        <Border Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" CornerRadius="12"/>
        <Grid Padding="12,10,12,9" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="POWER / PERFORMANCE MODEL" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Opacity="0.76"/>
                    <TextBlock Text="Where this CPU spends its time: package power left to right, CPU performance bottom to top." FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="7,2" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Top"><TextBlock x:Name="EvidenceBadge" Text="LEARNED HISTORY" FontSize="11" FontWeight="SemiBold"/></Border>
                <StackPanel Visibility="Collapsed">
                    <ComboBox x:Name="XDimensionSelector" SelectedIndex="0" SelectionChanged="OnDimensionChanged" AutomationProperties.Name="Atlas horizontal metric">
                        <ComboBoxItem Content="Package Power" Tag="PackagePower"/><ComboBoxItem Content="CPU Performance" Tag="EffectiveClock"/><ComboBoxItem Content="Cores Awake" Tag="ActiveCores"/><ComboBoxItem Content="CPU Pressure" Tag="CpuPressure"/>
                    </ComboBox>
                    <ComboBox x:Name="YDimensionSelector" SelectedIndex="1" SelectionChanged="OnDimensionChanged" AutomationProperties.Name="Atlas vertical metric">
                        <ComboBoxItem Content="Package Power" Tag="PackagePower"/><ComboBoxItem Content="CPU Performance" Tag="EffectiveClock"/><ComboBoxItem Content="Cores Awake" Tag="ActiveCores"/><ComboBoxItem Content="CPU Pressure" Tag="CpuPressure"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="2"><TextBlock Text="LEARNED PATTERN" FontSize="11" FontWeight="SemiBold" Opacity="0.56"/><TextBlock x:Name="WhatLearnedText" Text="Waiting for enough live history to learn this machine." FontSize="11" TextWrapping="Wrap" Opacity="0.86"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="RIGHT NOW" FontSize="11" FontWeight="SemiBold" Opacity="0.56"/><TextBlock x:Name="WhatDoingNowText" Text="Observing the machine." FontSize="11" TextWrapping="Wrap" Opacity="0.86"/></StackPanel>
            </Grid>

            <Grid Grid.Row="2" MinHeight="136" ColumnSpacing="5" RowSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                <TextBlock x:Name="YAxisLabel" Grid.Row="0" Text="CPU PERFORMANCE (%)" FontSize="11" Opacity="0.58" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.RenderTransform><RotateTransform Angle="-90"/></TextBlock.RenderTransform></TextBlock>
                <Grid Grid.Column="1" x:Name="AtlasPlotHost" MinWidth="120" MinHeight="124">
                    <Canvas x:Name="AtlasCanvas" SizeChanged="OnSizeChanged" IsHitTestVisible="False"/>
                    <Canvas x:Name="FrontierLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="CurrentPointLayer" IsHitTestVisible="False"><Ellipse x:Name="CurrentPointHalo" Width="20" Height="20" Stroke="{ThemeResource PowerFlowAccentBrush}" StrokeThickness="1" Opacity="0"/><Ellipse x:Name="CurrentPointDot" Width="9" Height="9" Fill="{ThemeResource PowerFlowAccentBrush}" Stroke="White" StrokeThickness="1.5" Opacity="0"/><TextBlock x:Name="YouAreHereLabel" Text="YOU ARE HERE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowAccentBrush}" Opacity="0"/></Canvas>
                    <Grid x:Name="AtlasHoverLayer" IsHitTestVisible="False"><Canvas x:Name="AtlasLinkedHoverLayer"/><Canvas x:Name="AtlasPointerHoverLayer"/></Grid>
                    <Canvas x:Name="InteractionLayer" Background="Transparent" PointerMoved="OnPointerMoved" PointerExited="OnPointerExited" PointerPressed="OnPointerPressed"/>
                    <Border x:Name="AtlasHoverCard" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0" Padding="8,6" CornerRadius="7" Background="{ThemeResource PowerFlowHoverBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" IsHitTestVisible="False"><TextBlock x:Name="AtlasHoverReadout" FontSize="11" TextWrapping="Wrap" MaxWidth="320"/></Border>
                    <Border x:Name="AtlasUnavailableMessage" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,9" CornerRadius="8" Background="{ThemeResource PowerFlowHoverBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1"><TextBlock x:Name="AtlasUnavailableText" Text="Waiting for enough power/performance history to build the model." FontSize="11" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/></Border>
                    <Border x:Name="SelectionCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Padding="8,5" CornerRadius="7" Background="{ThemeResource PowerFlowHoverBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" IsHitTestVisible="False"><TextBlock x:Name="SelectionReadout" FontSize="11" TextWrapping="Wrap" MaxWidth="280"/></Border>
                </Grid>
                <TextBlock x:Name="XAxisLabel" Grid.Row="1" Grid.Column="1" Text="PACKAGE POWER (W)" FontSize="11" Opacity="0.58" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="1"><TextBlock Text="MODEL CONFIDENCE" FontSize="11" FontWeight="SemiBold" Opacity="0.52"/><TextBlock x:Name="ConfidenceExplanationText" Text="Learning." FontSize="11" TextWrapping="Wrap" Opacity="0.72"/></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="ResidencySummary" Text="Waiting for operating history" FontSize="11" Opacity="0.52" TextAlignment="Right" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DimensionAvailabilityText" Text="Power + performance history" FontSize="11" Opacity="0.44" TextAlignment="Right" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>