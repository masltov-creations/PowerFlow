<UserControl
    x:Class="PowerFlow.App.Dashboard.OperationalContextControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid x:Name="SummaryLayer" Visibility="Collapsed" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding RecentEventLines[0]}" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><Button Content="RULES" FontSize="11" Padding="8,3" Click="OnRulesClicked"/><Button Content="SETTINGS" FontSize="11" Padding="8,3" Click="OnSettingsClicked"/></StackPanel>
        </Grid>

        <Grid x:Name="FullLayer" Visibility="Collapsed" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="RecentEventsRegion" CornerRadius="12" Background="{ThemeResource PowerFlowSurfaceBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="11">
                <StackPanel Spacing="5"><TextBlock Text="RECENT EVENTS" FontSize="12" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding RecentEventLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
            <Border x:Name="ActiveSourcesRegion" Grid.Column="1" CornerRadius="12" Background="{ThemeResource PowerFlowSurfaceBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="11">
                <StackPanel Spacing="5"><TextBlock Text="ACTIVE SOURCES" FontSize="12" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ActiveSourceLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
            <Border x:Name="QuickActionsRegion" Grid.Column="2" CornerRadius="12" Background="{ThemeResource PowerFlowSurfaceBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="11">
                <Grid RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="QUICK ACTIONS" FontSize="12" FontWeight="SemiBold"/><Button Grid.Row="1" Content="RULES / APPS" FontSize="11" HorizontalAlignment="Stretch" Click="OnRulesClicked"/><Button Grid.Row="2" Content="SETTINGS" FontSize="11" HorizontalAlignment="Stretch" Click="OnSettingsClicked"/></Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
