<UserControl
    x:Class="PowerFlow.App.Dashboard.EfficiencyCompareControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource PowerFlowSurfaceBrush}" Padding="18">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="EFFICIENCY COMPARE" FontSize="12" FontWeight="SemiBold" CharacterSpacing="150" Opacity="0.72"/>
                        <TextBlock Text="Measure equivalent CPU work and package energy before and after a policy change." FontSize="12" Opacity="0.62" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="9,4" CornerRadius="8" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="PhaseStatusText" Text="READY" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Border Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="12,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="WINDOW" FontSize="11" FontWeight="SemiBold" Opacity="0.56"/>
                            <ComboBox x:Name="DurationSelector" Width="110" SelectedIndex="0" AutomationProperties.Name="Comparison duration">
                                <ComboBoxItem Content="5 MIN"/>
                                <ComboBoxItem Content="30 MIN"/>
                                <ComboBoxItem Content="5 HR"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="StartBaselineButton" Content="START BASELINE" Margin="4,17,0,0" Padding="12,6" FontSize="11" FontWeight="SemiBold" Click="OnStartBaselineClicked"/>
                        <Button Grid.Column="2" x:Name="StartAfterButton" Content="START AFTER" Margin="0,17,0,0" Padding="12,6" FontSize="11" FontWeight="SemiBold" Click="OnStartAfterClicked"/>
                        <Button Grid.Column="3" x:Name="StopButton" Content="STOP" Margin="0,17,0,0" Padding="12,6" FontSize="11" Click="OnStopClicked"/>
                        <Button Grid.Column="4" x:Name="ResetButton" Content="RESET" Margin="0,17,0,0" Padding="12,6" FontSize="11" Click="OnResetClicked"/>
                        <TextBlock Grid.Column="5" x:Name="ExperimentHintText" Text="Record Baseline, change policy/mode, then record After. Recording does not change power policy." FontSize="11" Opacity="0.58" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,12,0,0"/>
                    </Grid>
                </Border>

                <Border x:Name="ResultBanner" Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="RESULT" FontSize="11" FontWeight="SemiBold" Opacity="0.56" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ResultText" Text="Complete Baseline and After to calculate equivalent-work savings." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="12,10">
                        <StackPanel Spacing="5">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="BASELINE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="130" Opacity="0.62"/><TextBlock Grid.Column="1" x:Name="BaselineCoverageText" Text="0% COVERAGE" FontSize="11" Opacity="0.48"/></Grid>
                            <TextBlock x:Name="BaselineWorkText" Text="CPU work —" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BaselineEnergyText" Text="Energy —" FontSize="12"/>
                            <TextBlock x:Name="BaselineEfficiencyText" Text="Efficiency —" FontSize="12"/>
                            <TextBlock x:Name="BaselinePressureText" Text="Pressure / queue —" FontSize="11" Opacity="0.62"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="12,10">
                        <StackPanel Spacing="5">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AFTER" FontSize="11" FontWeight="SemiBold" CharacterSpacing="130" Opacity="0.62"/><TextBlock Grid.Column="1" x:Name="AfterCoverageText" Text="0% COVERAGE" FontSize="11" Opacity="0.48"/></Grid>
                            <TextBlock x:Name="AfterWorkText" Text="CPU work —" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AfterEnergyText" Text="Energy —" FontSize="12"/>
                            <TextBlock x:Name="AfterEfficiencyText" Text="Efficiency —" FontSize="12"/>
                            <TextBlock x:Name="AfterPressureText" Text="Pressure / queue —" FontSize="11" Opacity="0.62"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="12,10">
                        <Grid RowSpacing="5">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="CUMULATIVE CPU WORK" FontSize="11" FontWeight="SemiBold" Opacity="0.58"/>
                            <Canvas x:Name="WorkChart" Grid.Row="1" MinWidth="220" SizeChanged="OnChartSizeChanged"/>
                            <TextBlock Grid.Row="2" Text="Nominal full-CPU equivalent minutes • Baseline vs After" FontSize="11" Opacity="0.48"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="12,10">
                        <Grid RowSpacing="5">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="CUMULATIVE PACKAGE ENERGY" FontSize="11" FontWeight="SemiBold" Opacity="0.58"/>
                            <Canvas x:Name="EnergyChart" Grid.Row="1" MinWidth="220" SizeChanged="OnChartSizeChanged"/>
                            <TextBlock Grid.Row="2" Text="Wh consumed over the same experiment window • Baseline vs After" FontSize="11" Opacity="0.48"/>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Text="CPU work is a normalized service index derived from Windows Processor Utility (full-machine nominal-capacity scale). It is not an application job counter. Equivalent-work savings compare After energy with the Baseline energy intensity for the same measured CPU work." FontSize="11" Opacity="0.52" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>