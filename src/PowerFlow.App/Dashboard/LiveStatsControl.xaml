<UserControl
    x:Class="PowerFlow.App.Dashboard.LiveStatsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="InlineStats" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="CPU" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Text="{Binding CpuLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowCpuBrush}"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="PACKAGE" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Text="{Binding WattsLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowPowerBrush}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="AVG CLOCK" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Text="{Binding FrequencyLabel}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
        </Grid>

        <Grid x:Name="CompactStatsRail" Visibility="Collapsed" RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CPU" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding CpuLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowCpuBrush}"/></Grid>
            <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PACKAGE" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding WattsLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowPowerBrush}"/></Grid>
            <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AVG CLOCK" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding FrequencyLabel}" FontSize="14" FontWeight="SemiBold"/></Grid>
        </Grid>

        <Grid x:Name="FullStatsRail" Visibility="Collapsed" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="LIVE STATS" FontSize="13" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="{ThemeResource PowerFlowHealthyBrush}"/><TextBlock Text="LIVE" FontSize="11" Foreground="{ThemeResource PowerFlowHealthyBrush}"/></StackPanel></Grid>
            <Border Grid.Row="1" CornerRadius="11" Background="{ThemeResource PowerFlowSurfaceElevatedBrush}" Padding="10">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CPU" FontSize="11" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Maximum="100" Value="{Binding CpuPercent}" Height="6" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding CpuLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowCpuBrush}"/></Grid>
            </Border>
            <Border Grid.Row="2" CornerRadius="11" Background="{ThemeResource PowerFlowSurfaceElevatedBrush}" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PACKAGE POWER" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding WattsLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowPowerBrush}"/></Grid></Border>
            <Border Grid.Row="3" CornerRadius="11" Background="{ThemeResource PowerFlowSurfaceElevatedBrush}" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AVG CLOCK" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding FrequencyLabel}" FontSize="17" FontWeight="SemiBold"/></Grid></Border>
            <Border Grid.Row="4" CornerRadius="11" Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="MEMORY" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="-" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/></Grid></Border>
        </Grid>
    </Grid>
</UserControl>
