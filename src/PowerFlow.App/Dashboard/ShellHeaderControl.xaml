<UserControl
    x:Class="PowerFlow.App.Dashboard.ShellHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard">
    <Grid>
        <Grid x:Name="MinimalHeader" ColumnSpacing="6" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="Assets/PowerFlow.png" Width="20" Height="20" Stretch="Uniform"/>
            <TextBlock x:Name="GlanceBrandText" Grid.Column="1" Text="PowerFlow" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource PowerFlowHealthyBrush}"/>
                <TextBlock Text="ACTIVE" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="CompactHeader" Visibility="Collapsed" ColumnSpacing="9" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="Assets/PowerFlow.png" Width="26" Height="26" Stretch="Uniform"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Power" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Flow" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowAccentBrush}"/>
            </StackPanel>
            <dash:PowerModeStripControl x:Name="CompactModeStrip" Grid.Column="2" HorizontalAlignment="Right" ModeRequested="OnModeRequested"/>
            <Border Grid.Column="3" Padding="6,2" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Center">
                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <Button x:Name="CompactNavigationButton" Grid.Column="4" Margin="4,0,0,0" Padding="8,4" ToolTipService.ToolTip="PowerFlow menu">
                <FontIcon Glyph="&#xE712;" FontSize="14"/>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="RULES / APPS" Click="OnRulesClicked"/>
                        <MenuFlyoutItem Text="SETTINGS" Click="OnSettingsClicked"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid x:Name="SystemHeader" Visibility="Collapsed" ColumnSpacing="10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Width="34" Height="34">
                <Ellipse Fill="{ThemeResource PowerFlowGlowBrush}" Opacity="0.65"/>
                <Image Source="Assets/PowerFlow.png" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock Text="Power" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Flow" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowAccentBrush}"/>
                </StackPanel>
                <TextBlock Text="POWER CONTROL" FontSize="11" CharacterSpacing="100" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
                <TextBlock Text="{Binding MachineLabel}" Visibility="{Binding HasMachineLabel, Converter={StaticResource BoolToVisibility}}" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="12,0,0,0">
                <TextBlock Text="{Binding StateLabel}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <dash:PowerModeStripControl x:Name="SystemModeStrip" Grid.Column="3" Margin="8,0" ModeRequested="OnModeRequested"/>
            <Border Grid.Column="4" Padding="7,3" CornerRadius="8" Background="{ThemeResource PowerFlowSubtleBrush}" VerticalAlignment="Center">
                <TextBlock Text="{Binding ControlBadgeLabel}" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border x:Name="PreviewBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Padding="6,2" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}">
            <TextBlock Text="PREVIEW · READ ONLY" FontSize="11" Foreground="{ThemeResource PowerFlowAccentBrush}"/>
        </Border>
    </Grid>
</UserControl>
