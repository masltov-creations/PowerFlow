<UserControl
    x:Class="PowerFlow.App.Dashboard.PerformanceTimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="TimelineRoot" MinHeight="190">
        <Border Background="{ThemeResource PowerFlowPanelBrush}"
                BorderBrush="{ThemeResource PowerFlowCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"/>
        <Grid Padding="12,10,12,9" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TimelineHeaderRow" Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="TimelineFooterRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid x:Name="TimelineHeader" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="LIVE PERFORMANCE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" Opacity="0.72"/>
                        <Border x:Name="EnvelopeBadge" Padding="7,2" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}">
                            <TextBlock x:Name="EnvelopeBadgeText" Text="LEARNING" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="WindowLabel" Text="60 SEC" FontSize="11" Opacity="0.50" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="GlanceSummary" Visibility="Collapsed" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LaneLabelColumn" Width="112"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="LaneLabels" Grid.Column="0" Padding="0,3,0,3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="CpuPressureLabel" Text="COMPUTE PRESSURE" FontSize="11" FontWeight="SemiBold" Opacity="0.62"/>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="CpuValueText" Text="-" FontSize="12"/>
                            <TextBlock x:Name="CpuThresholdText" Text="" FontSize="11" Opacity="0.52" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="PACKAGE POWER" FontSize="11" FontWeight="SemiBold" Opacity="0.62"/>
                        <TextBlock x:Name="PowerValueText" Text="—" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="CPU PERFORMANCE" FontSize="11" FontWeight="SemiBold" Opacity="0.62"/>
                        <TextBlock x:Name="ClockValueText" Text="—" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="CAPACITY / CORES" FontSize="11" FontWeight="SemiBold" Opacity="0.62"/>
                        <TextBlock x:Name="CoresValueText" Text="—" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" x:Name="TimelinePlotHost" MinWidth="120" MinHeight="132">
                    <Canvas x:Name="GridLayer" SizeChanged="OnSizeChanged" IsHitTestVisible="False"/>
                    <Canvas x:Name="PolicyTimeLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="PolicyValueLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="TraceLayer" IsHitTestVisible="False">
                        <Path x:Name="CpuTracePath" StrokeThickness="2.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="PowerTracePath" StrokeThickness="2.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="ClockTracePath" StrokeThickness="2.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <Canvas x:Name="CoreThreadLayer" IsHitTestVisible="False">
                        <Path x:Name="CoreParkedPath"/>
                        <Path x:Name="CoreAwakePath"/>
                        <Path x:Name="CoreActivePath"/>
                        <Path x:Name="CoreActiveMediumPath"/>
                        <Path x:Name="CoreActiveHighPath"/>
                        <Path x:Name="CoreActiveHotPath"/>
                        <Path x:Name="DeliveredCapacityPath" StrokeThickness="1.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="RequestedCapacityPath" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <Canvas x:Name="PolicyHandleLayer" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Canvas x:Name="ActorDecisionLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False"/>
                    <Grid x:Name="HoverLayer" IsHitTestVisible="False">
                        <Canvas x:Name="LinkedHoverLayer"/>
                        <Canvas x:Name="PolicyHoverLayer"/>
                        <Line x:Name="InspectionCursor" Stroke="#8294A6" StrokeThickness="1" Visibility="Collapsed" Opacity="0.92"/>
                    </Grid>
                    <Canvas x:Name="CursorLayer" Background="Transparent" PointerMoved="OnPointerMoved" PointerExited="OnPointerExited" PointerPressed="OnPointerPressed" PointerReleased="OnPointerReleased" PointerCanceled="OnPointerCanceled"/>
                    <Border x:Name="CursorCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,5,5,0" Padding="8,5" CornerRadius="7"
                            Background="{ThemeResource PowerFlowHoverBrush}"
                            BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" IsHitTestVisible="False">
                        <TextBlock x:Name="CursorReadout" FontSize="11" TextWrapping="Wrap" MaxWidth="360"/>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="TimelineFooter" Grid.Row="2" Margin="120,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WindowStartLabel" Text="-60s" FontSize="11" Opacity="0.42"/>
                <TextBlock Grid.Column="1" Text="NOW" FontSize="11" FontWeight="SemiBold" Opacity="0.62"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
