<Window
    x:Class="PowerFlow.App.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard"
    xmlns:settings="using:PowerFlow.App.Settings">
    <Grid x:Name="ShellRoot" Background="{ThemeResource PowerFlowCanvasBrush}">
        <Grid x:Name="CockpitRoot">
            <NavigationView
                x:Name="NavigationRail"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                IsPaneToggleButtonVisible="False"
                IsPaneOpen="True"
                PaneDisplayMode="Left"
                OpenPaneLength="144"
                CompactPaneLength="46"
                SelectionChanged="OnNavigationChanged"
                Background="Transparent">
                <NavigationView.PaneHeader>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,8,0,12">
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="{ThemeResource PowerFlowGlowBrush}"/>
                            <Image Source="Assets/PowerFlow.png" Width="25" Height="25" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="POWERFLOW" FontSize="12" FontWeight="SemiBold" CharacterSpacing="70"/>
                            <TextBlock Text="POWER CONTROL" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </NavigationView.PaneHeader>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Dashboard" Tag="flow"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Rules / Apps" Tag="rules"><NavigationViewItem.Icon><SymbolIcon Symbol="List"/></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid x:Name="SectionHost">
                    <Grid x:Name="CockpitSurface" Padding="16" RowSpacing="12" Background="{ThemeResource PowerFlowSurfaceBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="SystemHeaderRowDefinition" Height="Auto"/>
                            <RowDefinition x:Name="ModeBandRowDefinition" Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition x:Name="ControlBandRowDefinition" Height="Auto"/>
                            <RowDefinition x:Name="SecondaryBandRowDefinition" Height="Auto"/>
                            <RowDefinition x:Name="FooterRowDefinition" Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="SystemHeaderRow" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <dash:ShellHeaderControl x:Name="SystemHeaderHost"/>
                            <StackPanel x:Name="PresentationActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="CompactButton" Content="COMPACT" Visibility="Collapsed" FontSize="11" Padding="10,5" Click="OnCompactClicked"/>
                                <Button x:Name="PresentationToggleButton" Content="EXPAND" FontSize="11" FontWeight="SemiBold" Padding="12,5" Click="OnPresentationToggleClicked"/>
                            </StackPanel>
                        </Grid>

                        <dash:PowerModeControl x:Name="PowerModeBandHost" Grid.Row="1" ModeRequested="OnPowerModeRequested"/>

                        <Grid x:Name="PrimaryAnalyticalRow" Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*" x:Name="PrimaryGraphColumn"/>
                                <ColumnDefinition Width="3*" x:Name="PrimaryStatsColumn"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TrajectoryInstrument" Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="12,10">
                                <dash:TrajectoryControl x:Name="Trajectory"/>
                            </Border>
                            <Border x:Name="LiveStatsInstrument" Grid.Column="1" Style="{StaticResource PowerFlowInstrumentCardStyle}">
                                <dash:LiveStatsControl x:Name="LiveStatsHost"/>
                            </Border>
                        </Grid>

                        <dash:ControlContextControl
                            x:Name="ControlContextBandHost"
                            Grid.Row="3"
                            ReleaseManualRequested="OnReleaseManualRequested"/>

                        <dash:OperationalContextControl
                            x:Name="SecondaryOperationalRow"
                            Grid.Row="4"
                            RulesRequested="OnOperationalRulesRequested"
                            SettingsRequested="OnOperationalSettingsRequested"/>

                        <Grid x:Name="StatusFooter" Grid.Row="5" ColumnSpacing="10" Opacity="0.78">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource PowerFlowHealthyBrush}"/>
                                <TextBlock Text="POWERFLOW ACTIVE" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CauseLabel}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="NEXT" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding NextActionLabel}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <settings:RulesPage x:Name="RulesPanel" Visibility="Collapsed"/>
                    <settings:SettingsPage x:Name="SettingsPanel" Visibility="Collapsed"/>
                </Grid>
            </NavigationView>
        </Grid>
        <Border x:Name="GlanceTapTarget" Visibility="Collapsed" Background="Transparent" Tapped="OnGlanceTapped" AutomationProperties.Name="Open PowerFlow dashboard"/>
    </Grid>
</Window>