<Window
    x:Class="PowerFlow.App.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard"
    xmlns:settings="using:PowerFlow.App.Settings">
    <Grid x:Name="ShellRoot" Background="{ThemeResource PowerFlowWindowBackgroundBrush}">
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Top" SelectionChanged="OnNavigationChanged" Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="flow"/>
                <NavigationViewItem Content="Rules" Tag="rules"/>
                <NavigationViewItem Content="Settings" Tag="settings"/>
            </NavigationView.MenuItems>
            <Grid>
                <Grid x:Name="DashboardPanel" Padding="12,7,12,10" RowSpacing="7">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="HeaderGrid" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="IdentityPanel" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="POWERFLOW" FontSize="11" CharacterSpacing="180" Opacity="0.46" VerticalAlignment="Center"/>
                                <Border x:Name="PreviewModeBadge" Visibility="Collapsed" Padding="6,1" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1"><TextBlock Text="PREVIEW · READ ONLY" FontSize="11" CharacterSpacing="50"/></Border>
                                <Border Padding="6,1" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}"><TextBlock Text="{Binding BadgeLabel}" FontSize="11" CharacterSpacing="45"/></Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="StateLabelText" Text="{Binding StateLabel}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ReasonText" Text="{Binding Reason}" FontSize="12" Opacity="0.58" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="360"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="CompactTelemetryStrip" Grid.Column="1" CornerRadius="9" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="8,4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="CPU" FontSize="11" Opacity="0.45"/><TextBlock x:Name="CompactCpuValue" Text="{Binding CpuLabel}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><TextBlock Text="W" FontSize="11" Opacity="0.45"/><TextBlock x:Name="CompactWattsValue" Text="{Binding WattsLabel}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"><TextBlock Text="AVG" FontSize="11" Opacity="0.45"/><TextBlock x:Name="CompactClockValue" Text="{Binding FrequencyLabel}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="TelemetryCard" Grid.Column="1" Visibility="Collapsed" CornerRadius="10" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="9,5">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CPU" FontSize="11" CharacterSpacing="70" Opacity="0.44"/><TextBlock x:Name="CpuValueText" Text="{Binding CpuLabel}" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="PACKAGE W" FontSize="11" CharacterSpacing="55" Opacity="0.44"/><TextBlock x:Name="WattsValueText" Text="{Binding WattsLabel}" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="AVG CLOCK" FontSize="11" CharacterSpacing="45" Opacity="0.44"/><TextBlock x:Name="ClockValueText" Text="{Binding FrequencyLabel}" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="PresentationActions" Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Button x:Name="CompactButton" Content="COMPACT" Visibility="Collapsed" FontSize="11" Padding="9,5" Click="OnCompactClicked" AutomationProperties.Name="Return to compact PowerFlow dashboard"/>
                            <Button x:Name="PresentationToggleButton" Content="EXPAND" FontSize="11" FontWeight="SemiBold" Padding="10,5" Click="OnPresentationToggleClicked" AutomationProperties.Name="Expand PowerFlow dashboard"/>
                        </StackPanel>
                    </Grid>
                    <dash:TrajectoryControl x:Name="Trajectory" Grid.Row="1"/>
                    <Border x:Name="ExpandedContextRail" Grid.Row="2" Visibility="Collapsed" CornerRadius="10" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="11,7">
                        <Grid x:Name="ExpandedContextGrid" ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="1"><TextBlock Text="NEXT" FontSize="11" CharacterSpacing="70" Opacity="0.44"/><TextBlock Text="{Binding NextActionLabel}" FontSize="13" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="POLICY WINDOW" FontSize="11" CharacterSpacing="45" Opacity="0.44"/><TextBlock Text="{Binding PromotionRuleLabel}" FontSize="12"/><TextBlock Text="{Binding QuietRuleLabel}" FontSize="11" Opacity="0.62"/></StackPanel>
                            <StackPanel Grid.Column="2" Spacing="1"><TextBlock Text="TRIGGER" FontSize="11" CharacterSpacing="70" Opacity="0.44"/><TextBlock Text="{Binding TriggerApplication}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Windows-reported average CPU clock" FontSize="11" Opacity="0.46"/></StackPanel>
                            <StackPanel x:Name="FullScreenContext" Grid.Column="3" Visibility="Collapsed" Spacing="1"><TextBlock Text="LIVE CONTEXT" FontSize="11" CharacterSpacing="55" Opacity="0.44"/><TextBlock Text="{Binding BadgeLabel}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Trajectory + policy stay live while this view scales" FontSize="11" Opacity="0.56" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <settings:RulesPage x:Name="RulesPanel" Visibility="Collapsed"/>
                <settings:SettingsPage x:Name="SettingsPanel" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
        <Border x:Name="GlanceTapTarget" Visibility="Collapsed" Background="Transparent" Tapped="OnGlanceTapped" AutomationProperties.Name="Open PowerFlow dashboard"/>
    </Grid>
</Window>