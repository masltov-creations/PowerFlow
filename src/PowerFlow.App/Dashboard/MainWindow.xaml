<Window
    x:Class="PowerFlow.App.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard"
    xmlns:settings="using:PowerFlow.App.Settings">
    <Grid x:Name="Root" Background="{ThemeResource PowerFlowWindowBackgroundBrush}">
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Top" SelectionChanged="OnNavigationChanged" Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="flow"/>
                <NavigationViewItem Content="Rules" Tag="rules"/>
                <NavigationViewItem Content="Settings" Tag="settings"/>
            </NavigationView.MenuItems>
            <Grid>
                <Grid x:Name="DashboardPanel" Padding="12,6,12,9" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="POWERFLOW" FontSize="9" CharacterSpacing="180" Opacity="0.45" VerticalAlignment="Center"/>
                                <Border x:Name="PreviewModeBadge" Visibility="Collapsed" Padding="6,1" CornerRadius="7" Background="#164DE7D3" BorderBrush="#504DE7D3" BorderThickness="1"><TextBlock Text="PREVIEW · READ ONLY" FontSize="7.5" CharacterSpacing="50" Foreground="#FF42CDBA"/></Border>
                                <Border Padding="6,1" CornerRadius="7" Background="{ThemeResource PowerFlowSubtleBrush}"><TextBlock Text="{Binding BadgeLabel}" FontSize="7.5" CharacterSpacing="45"/></Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StateLabel}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Reason}" FontSize="9.5" Opacity="0.58" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="360"/>
                            </StackPanel>
                            <TextBlock Text="{Binding NextActionLabel}" FontSize="8.5" Opacity="0.38"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="9,6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CPU" FontSize="7.5" CharacterSpacing="70" Opacity="0.42"/><TextBlock Text="{Binding CpuLabel}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="PACKAGE W" FontSize="7.5" CharacterSpacing="55" Opacity="0.42"/><TextBlock Text="{Binding WattsLabel}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="GHz" FontSize="7.5" CharacterSpacing="70" Opacity="0.42"/><TextBlock Text="{Binding FrequencyLabel}" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="TRIGGER" FontSize="7.5" CharacterSpacing="65" Opacity="0.42"/><TextBlock Text="{Binding TriggerApplication}" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="9" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="7,5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="MODE" FontSize="7.5" CharacterSpacing="85" Opacity="0.42" VerticalAlignment="Center" Margin="2,0,2,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="AutoOverrideButton" Content="AUTO" Click="OnAutoOverride" Padding="9,3" FontSize="8.5" AutomationProperties.Name="Automatic power policy"/>
                                <ToggleButton x:Name="SaverOverrideButton" Content="SAVER" Click="OnSaverOverride" Padding="9,3" FontSize="8.5" AutomationProperties.Name="Lock Power Saver"/>
                                <ToggleButton x:Name="BalancedOverrideButton" Content="BALANCED" Click="OnBalancedOverride" Padding="9,3" FontSize="8.5" AutomationProperties.Name="Lock Balanced"/>
                                <ToggleButton x:Name="PerformanceOverrideButton" Content="PERFORMANCE" Click="OnPerformanceOverride" Padding="9,3" FontSize="8.5" AutomationProperties.Name="Lock High Performance"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="Click a mode to lock it · AUTO releases manual lock" FontSize="8.5" Opacity="0.38" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="7" MinHeight="250">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.65*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="11" Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="8">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="CPU + PACKAGE POWER" FontSize="9" FontWeight="SemiBold" CharacterSpacing="55"/><TextBlock Text="drag QUIET / PROMOTE · hover values" FontSize="8.5" Opacity="0.38" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <ToggleButton x:Name="Range60Button" Content="60s" IsChecked="True" Click="OnRange60" Padding="7,2" FontSize="8"/>
                                        <ToggleButton x:Name="Range120Button" Content="2m" Click="OnRange120" Padding="7,2" FontSize="8"/>
                                    </StackPanel>
                                </Grid>
                                <dash:TelemetryGraphControl x:Name="TelemetryGraph" Grid.Row="1"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="11" Background="{ThemeResource PowerFlowPanelBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="8">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="AUTOMATIC RULES" FontSize="9" FontWeight="SemiBold" CharacterSpacing="55"/>
                                <dash:RuleFlowControl x:Name="RuleFlow" Grid.Row="1" Margin="0,3,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.65*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="9" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="8"><dash:DecisionPressureControl x:Name="DecisionPressure"/></Border>
                        <Border Grid.Column="1" CornerRadius="9" Background="{ThemeResource PowerFlowCardBrush}" BorderBrush="{ThemeResource PowerFlowCardBorderBrush}" BorderThickness="1" Padding="8,6">
                            <StackPanel><TextBlock Text="RECENT" FontSize="7.5" CharacterSpacing="70" Opacity="0.44"/><ListView ItemsSource="{Binding History}" MaxHeight="40" Background="Transparent" BorderThickness="0" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding To}" FontSize="8" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Reason}" FontSize="8" Opacity="0.43" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <settings:RulesPage x:Name="RulesPanel" Visibility="Collapsed"/>
                <settings:SettingsPage x:Name="SettingsPanel" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
