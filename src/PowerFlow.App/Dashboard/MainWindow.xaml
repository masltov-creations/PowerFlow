<Window
    x:Class="PowerFlow.App.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard"
    xmlns:settings="using:PowerFlow.App.Settings">
    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0A0D12" Offset="0"/>
                <GradientStop Color="#FF101520" Offset="0.55"/>
                <GradientStop Color="#FF0B0E13" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Top" SelectionChanged="OnNavigationChanged" Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Flow" Tag="flow"/>
                <NavigationViewItem Content="Rules" Tag="rules"/>
                <NavigationViewItem Content="Settings" Tag="settings"/>
            </NavigationView.MenuItems>
            <Grid>
                <Grid x:Name="DashboardPanel" Padding="34,24,34,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="POWERFLOW" FontSize="12" CharacterSpacing="260" Opacity="0.5" VerticalAlignment="Center"/>
                                <Border x:Name="PreviewModeBadge" Visibility="Collapsed" Padding="9,3" CornerRadius="10" Background="#184DE7D3" BorderBrush="#554DE7D3" BorderThickness="1">
                                    <TextBlock Text="PREVIEW · READ ONLY" FontSize="10" CharacterSpacing="80" Foreground="#FF7DEDDC"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StateLabel}" FontSize="48" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Reason}" FontSize="15" Opacity="0.72" TextWrapping="Wrap" MaxWidth="780"/>
                            <TextBlock Text="{Binding NextActionLabel}" FontSize="13" Opacity="0.48" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Padding="14,7" CornerRadius="18" Background="#18FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock Text="{Binding BadgeLabel}" FontSize="12" CharacterSpacing="70"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,4">
                        <dash:FlowFieldControl x:Name="FlowField" VerticalAlignment="Center"/>
                        <ProgressBar Value="{Binding FlowProgress}" Maximum="1" Height="2" VerticalAlignment="Bottom" Margin="110,0" Opacity="0.42"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <StackPanel MinWidth="128"><TextBlock Text="CPU" FontSize="11" Opacity="0.45"/><TextBlock Text="{Binding CpuLabel}" FontSize="24"/></StackPanel>
                            <Rectangle Width="1" Height="42" Fill="#20FFFFFF" Margin="16,0"/>
                            <StackPanel MinWidth="128"><TextBlock Text="PACKAGE" FontSize="11" Opacity="0.45"/><TextBlock Text="{Binding WattsLabel}" FontSize="24"/></StackPanel>
                            <Rectangle Width="1" Height="42" Fill="#20FFFFFF" Margin="16,0"/>
                            <StackPanel MinWidth="138"><TextBlock Text="FREQUENCY" FontSize="11" Opacity="0.45"/><TextBlock Text="{Binding FrequencyLabel}" FontSize="24"/></StackPanel>
                            <Rectangle Width="1" Height="42" Fill="#20FFFFFF" Margin="16,0"/>
                            <StackPanel MaxWidth="260"><TextBlock Text="TRIGGER" FontSize="11" Opacity="0.45"/><TextBlock Text="{Binding TriggerApplication}" FontSize="14" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0">
                            <TextBlock Text="RECENT TRANSITIONS" FontSize="11" CharacterSpacing="100" Opacity="0.42" Margin="0,0,0,6"/>
                            <ListView ItemsSource="{Binding History}" MaxHeight="110" Background="Transparent" BorderThickness="0" IsItemClickEnabled="False" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                            <TextBlock Text="{Binding To}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Reason}" FontSize="12" Opacity="0.48" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </Grid>

                <settings:RulesPage x:Name="RulesPanel" Visibility="Collapsed"/>
                <settings:SettingsPage x:Name="SettingsPanel" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>

