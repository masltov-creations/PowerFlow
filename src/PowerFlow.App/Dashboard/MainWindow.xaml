<Window
    x:Class="PowerFlow.App.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard"
    xmlns:settings="using:PowerFlow.App.Settings">
    <Grid x:Name="ShellRoot" Background="{ThemeResource PowerFlowCanvasBrush}">
        <Grid x:Name="CockpitRoot">
            <NavigationView x:Name="NavigationRail" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" IsPaneOpen="True" PaneDisplayMode="Left" OpenPaneLength="144" CompactPaneLength="46" SelectionChanged="OnNavigationChanged" Background="Transparent">
                <NavigationView.PaneHeader>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,8,0,12">
                        <Grid Width="28" Height="28"><Ellipse Fill="{ThemeResource PowerFlowGlowBrush}"/><Image Source="ms-appx:///Assets/PowerFlow.png" Width="25" Height="25" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="0"><TextBlock Text="POWERFLOW" FontSize="12" FontWeight="SemiBold" CharacterSpacing="70"/><TextBlock Text="ADAPTIVE GOVERNOR" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/></StackPanel>
                    </StackPanel>
                </NavigationView.PaneHeader>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Live" Tag="flow"><NavigationViewItem.Icon><SymbolIcon Symbol="Play"/></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Workloads" Tag="rules"><NavigationViewItem.Icon><SymbolIcon Symbol="List"/></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Baseline" Tag="profile"><NavigationViewItem.Icon><SymbolIcon Symbol="Repair"/></NavigationViewItem.Icon></NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems><NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
                <Grid x:Name="SectionHost">
                    <Grid.RowDefinitions><RowDefinition x:Name="SystemHeaderRowDefinition" Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid x:Name="SystemHeaderRow">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="DragStripRowDefinition" Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="DragSurface" Grid.Row="0" Height="10" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Move PowerFlow window" ToolTipService.ToolTip="Drag to move PowerFlow">
                                <Border x:Name="DragHandle" Width="42" Height="3" CornerRadius="2" Background="{ThemeResource PowerFlowTextMutedBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Border>
                            <Grid x:Name="HeaderContentRow" Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <dash:ShellHeaderControl x:Name="SystemHeaderHost" LiveRequested="OnHeaderLiveRequested" RulesRequested="OnHeaderRulesRequested" BaselineRequested="OnHeaderBaselineRequested" SettingsRequested="OnHeaderSettingsRequested"/>
                                <StackPanel x:Name="PresentationActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="ViewModeButton" MinHeight="34" MinWidth="92" FontSize="11" FontWeight="SemiBold" Padding="10,5" ToolTipService.ToolTip="Change PowerFlow view">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock x:Name="ViewModeLabel" Text="COMPACT" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xE70D;" FontSize="11"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="HOVER" Click="OnHoverViewClicked"/>
                                                <MenuFlyoutItem Text="COMPACT" Click="OnCompactViewClicked"/>
                                                <MenuFlyoutItem Text="EXPANDED" Click="OnExpandedViewClicked"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Name="PresentationToggleButton" MinHeight="34" Content="WORKSPACE" Visibility="Collapsed" FontSize="11" FontWeight="SemiBold" Padding="10,5" Click="OnPresentationToggleClicked"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    <Grid x:Name="SectionContentHost" Grid.Row="1">
<Grid x:Name="CockpitSurface" Padding="16" RowSpacing="12" Background="{ThemeResource PowerFlowSurfaceBrush}">
                        <Grid.RowDefinitions><RowDefinition x:Name="TimelineRowDefinition" Height="*" MinHeight="156"/><RowDefinition x:Name="AdaptiveControlRowDefinition" Height="Auto"/><RowDefinition x:Name="FooterRowDefinition" Height="Auto"/></Grid.RowDefinitions>

                        <Grid x:Name="AnalyticalInstrumentHost" Grid.Row="0"><dash:PerformanceTimelineControl x:Name="PerformanceTimeline"/></Grid>
                        <Grid x:Name="AdaptiveControlRegion" Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="GovernorModelColumn" Width="1.05*"/><ColumnDefinition x:Name="ActorContextColumn" Width="0.95*"/></Grid.ColumnDefinitions>
                            <Border x:Name="MachineEnvelopePanel" Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="9,4">
                                <Grid RowSpacing="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="GOVERNOR MODELS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource PowerFlowTextMutedBrush}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:Name="GovernorReferenceText" Text="BAL-E" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
                                            <TextBlock x:Name="ModelConfidenceText" Text="LEARNING" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CurrentAutoStateText" Text="APPLIED · AUTO / OBSERVING" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TensionShadowStateText" Grid.Column="1" Text="SHADOW · T50" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnSpacing="4" Height="22">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="RELAXED" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1">
                                            <Slider x:Name="GovernorTensionSlider" Minimum="0" Maximum="100" Value="50" StepFrequency="1" TickFrequency="25" Height="22" Margin="2,-2" VerticalAlignment="Center" AutomationProperties.Name="Governor tension shadow model" ToolTipService.ToolTip="Shadow only: changes the alternative governor envelope. It does not apply a power mode."/>
                                            <TextBlock x:Name="GovernorTensionValueText" Text="T50" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="RESPONSIVE" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="3" ColumnSpacing="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="SAVER" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="BAL-E" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="BAL-P" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="PERF" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid x:Name="GovernorDetailPanel" Grid.Row="4" ColumnSpacing="8" Visibility="Collapsed" Opacity="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock x:Name="CurrentAutoDetailText" Text="MODEL OBSERVING" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="CurrentEvidenceText" Text="ESTIMATE · gathering baseline context" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock x:Name="TensionShadowDetailText" Text="WOULD USE · observing" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="ShadowEvidenceText" Text="ESTIMATE · gathering baseline context" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="SelectedActorPanel" Grid.Column="1" Style="{StaticResource PowerFlowInstrumentCardStyle}" Padding="12,9"><Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CURRENT ACTOR" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{ThemeResource PowerFlowTextMutedBrush}"/><TextBlock x:Name="DecisionStateText" Grid.Column="1" Text="OBSERVING" FontSize="11" FontWeight="SemiBold"/></Grid><TextBlock x:Name="SelectedActorNameText" Grid.Row="1" Text="SYSTEM" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DecisionExplanationText" Grid.Row="2" Text="No dominant app pressure identified" FontSize="11" Foreground="{ThemeResource PowerFlowTextMutedBrush}" TextTrimming="CharacterEllipsis"/></Grid></Border>
                        </Grid>
                        <Grid x:Name="StatusFooter" Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{ThemeResource PowerFlowHealthyBrush}"/><TextBlock Text="POWERFLOW ACTIVE" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding CauseLabel}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><TextBlock Text="NEXT" FontSize="11" Foreground="{ThemeResource PowerFlowTextSecondaryBrush}"/><TextBlock Text="{Binding NextActionLabel}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240"/></StackPanel></Grid>
                    </Grid>
                    <dash:CpuCapabilityProfileControl x:Name="CpuProfilePanel" Visibility="Collapsed"/>
                    <settings:RulesPage x:Name="RulesPanel" Visibility="Collapsed"/>
                    <settings:SettingsPage x:Name="SettingsPanel" Visibility="Collapsed"/>
                    <Border x:Name="GlanceTapTarget" Visibility="Collapsed" Background="Transparent" Tapped="OnGlanceTapped" PointerPressed="OnHoverSurfacePointerPressed" PointerMoved="OnHoverSurfacePointerMoved" PointerReleased="OnHoverSurfacePointerReleased" PointerCanceled="OnHoverSurfacePointerCanceled" PointerCaptureLost="OnHoverSurfacePointerCaptureLost" AutomationProperties.Name="Open PowerFlow dashboard"/>
                                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>

    </Grid>
</Window>
