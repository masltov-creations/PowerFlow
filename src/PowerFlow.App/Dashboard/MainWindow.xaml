<Window
    x:Class="PowerFlow.App.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard"
    xmlns:settings="using:PowerFlow.App.Settings">
    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF080B10" Offset="0"/>
                <GradientStop Color="#FF101722" Offset="0.58"/>
                <GradientStop Color="#FF090C11" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Top" SelectionChanged="OnNavigationChanged" Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="flow"/>
                <NavigationViewItem Content="Rules" Tag="rules"/>
                <NavigationViewItem Content="Settings" Tag="settings"/>
            </NavigationView.MenuItems>
            <Grid>
                <Grid x:Name="DashboardPanel" Padding="24,18,24,22" RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="POWERFLOW" FontSize="11" CharacterSpacing="250" Opacity="0.48" VerticalAlignment="Center"/>
                                <Border x:Name="PreviewModeBadge" Visibility="Collapsed" Padding="8,3" CornerRadius="9" Background="#164DE7D3" BorderBrush="#504DE7D3" BorderThickness="1"><TextBlock Text="PREVIEW · READ ONLY" FontSize="9" CharacterSpacing="80" Foreground="#FF7DEDDC"/></Border>
                                <Border Padding="8,3" CornerRadius="9" Background="#12FFFFFF"><TextBlock Text="{Binding BadgeLabel}" FontSize="9" CharacterSpacing="70"/></Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StateLabel}" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Reason}" FontSize="13" Opacity="0.68" TextWrapping="Wrap" MaxWidth="650"/>
                            <TextBlock Text="{Binding NextActionLabel}" FontSize="11" Opacity="0.42"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="16,12">
                            <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CPU" FontSize="9" CharacterSpacing="100" Opacity="0.42"/><TextBlock Text="{Binding CpuLabel}" FontSize="23" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="PACKAGE POWER" FontSize="9" CharacterSpacing="70" Opacity="0.42"/><TextBlock Text="{Binding WattsLabel}" FontSize="23" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="FREQUENCY" FontSize="9" CharacterSpacing="80" Opacity="0.42"/><TextBlock Text="{Binding FrequencyLabel}" FontSize="23" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="ACTIVE TRIGGER" FontSize="9" CharacterSpacing="80" Opacity="0.42"/><TextBlock Text="{Binding TriggerApplication}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="foreground / explicit rule" FontSize="10" Opacity="0.35"/></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <dash:StateRailControl x:Name="StateRail" Grid.Row="1"/>

                    <Grid Grid.Row="2" ColumnSpacing="16" MinHeight="390">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="16" Background="#08000000" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="15">
                            <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU + PACKAGE POWER" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80"/><TextBlock Text="LAST 60 SECONDS · CPU thresholds overlaid · dual scale" FontSize="10" Opacity="0.4"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="● CPU %" Foreground="#FF54E0CF" FontSize="10"/><TextBlock Text="● PACKAGE W" Foreground="#FF7DA8FF" FontSize="10"/></StackPanel></Grid>
                                <dash:TelemetryGraphControl x:Name="TelemetryGraph" Grid.Row="1"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="16" Background="#08000000" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="15">
                            <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="AUTOMATIC RULES" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80"/><TextBlock Text="Live policy chain" FontSize="10" Opacity="0.4"/></StackPanel><dash:RuleFlowControl x:Name="RuleFlow" Grid.Row="1" Margin="0,6,0,0"/></Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="15"><dash:DecisionPressureControl x:Name="DecisionPressure"/></Border>
                        <Border Grid.Column="1" CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="15">
                            <StackPanel><TextBlock Text="RECENT TRANSITIONS" FontSize="10" CharacterSpacing="90" Opacity="0.46" Margin="0,0,0,5"/><ListView ItemsSource="{Binding History}" MaxHeight="82" Background="Transparent" BorderThickness="0" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding To}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Reason}" FontSize="10" Opacity="0.48" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <settings:RulesPage x:Name="RulesPanel" Visibility="Collapsed"/>
                <settings:SettingsPage x:Name="SettingsPanel" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
