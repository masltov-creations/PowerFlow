<Window
    x:Class="PowerFlow.App.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dash="using:PowerFlow.App.Dashboard"
    xmlns:settings="using:PowerFlow.App.Settings">
    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF080B10" Offset="0"/>
                <GradientStop Color="#FF101722" Offset="0.58"/>
                <GradientStop Color="#FF090C11" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Top" SelectionChanged="OnNavigationChanged" Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="flow"/>
                <NavigationViewItem Content="Rules" Tag="rules"/>
                <NavigationViewItem Content="Settings" Tag="settings"/>
            </NavigationView.MenuItems>
            <Grid>
                <Grid x:Name="DashboardPanel" Padding="18,10,18,14" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.85*"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="POWERFLOW" FontSize="10" CharacterSpacing="220" Opacity="0.45" VerticalAlignment="Center"/>
                                <Border x:Name="PreviewModeBadge" Visibility="Collapsed" Padding="7,2" CornerRadius="8" Background="#164DE7D3" BorderBrush="#504DE7D3" BorderThickness="1"><TextBlock Text="PREVIEW · READ ONLY" FontSize="8" CharacterSpacing="70" Foreground="#FF7DEDDC"/></Border>
                                <Border Padding="7,2" CornerRadius="8" Background="#12FFFFFF"><TextBlock Text="{Binding BadgeLabel}" FontSize="8" CharacterSpacing="60"/></Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StateLabel}" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Reason}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" MaxWidth="410"/>
                            <TextBlock Text="{Binding NextActionLabel}" FontSize="10" Opacity="0.4"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="12,8">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CPU" FontSize="8" CharacterSpacing="90" Opacity="0.4"/><TextBlock Text="{Binding CpuLabel}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="PACKAGE W" FontSize="8" CharacterSpacing="70" Opacity="0.4"/><TextBlock Text="{Binding WattsLabel}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="GHz" FontSize="8" CharacterSpacing="90" Opacity="0.4"/><TextBlock Text="{Binding FrequencyLabel}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="TRIGGER" FontSize="8" CharacterSpacing="80" Opacity="0.4"/><TextBlock Text="{Binding TriggerApplication}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="foreground / explicit rule" FontSize="9" Opacity="0.32"/></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <dash:StateRailControl x:Name="StateRail" Grid.Row="1"/>

                    <Grid Grid.Row="2" ColumnSpacing="10" MinHeight="292">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.45*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="14" Background="#08000000" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="10">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="CPU + PACKAGE POWER" FontSize="10" FontWeight="SemiBold" CharacterSpacing="70"/><TextBlock Text="thresholds + plan transitions · hover for exact values" FontSize="9" Opacity="0.38"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <ToggleButton x:Name="Range60Button" Content="60s" IsChecked="True" Click="OnRange60" Padding="8,3" FontSize="9"/>
                                        <ToggleButton x:Name="Range120Button" Content="2m" Click="OnRange120" Padding="8,3" FontSize="9"/>
                                    </StackPanel>
                                </Grid>
                                <dash:TelemetryGraphControl x:Name="TelemetryGraph" Grid.Row="1"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="14" Background="#08000000" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="10">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="AUTOMATIC RULES" FontSize="10" FontWeight="SemiBold" CharacterSpacing="70"/><TextBlock Text="live policy chain" FontSize="9" Opacity="0.38"/></StackPanel>
                                <dash:RuleFlowControl x:Name="RuleFlow" Grid.Row="1" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.45*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="10"><dash:DecisionPressureControl x:Name="DecisionPressure"/></Border>
                        <Border Grid.Column="1" CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="10">
                            <StackPanel><TextBlock Text="RECENT TRANSITIONS" FontSize="9" CharacterSpacing="80" Opacity="0.44" Margin="0,0,0,3"/><ListView ItemsSource="{Binding History}" MaxHeight="64" Background="Transparent" BorderThickness="0" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding To}" FontSize="9" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Reason}" FontSize="9" Opacity="0.45" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <settings:RulesPage x:Name="RulesPanel" Visibility="Collapsed"/>
                <settings:SettingsPage x:Name="SettingsPanel" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
